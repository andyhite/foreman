#!/bin/sh
# Open the fleet dashboard as a herdr popup.
#
# The palette lists actions, not panes, so reaching a `[[panes]]` entrypoint
# from a keybinding or the palette needs an action that opens it. A wrapper
# rather than a bare argv command because plugin commands are not run through a
# shell: $HERDR_BIN_PATH is the portable way to reach the running herdr, and
# nothing expands it inside a manifest array.
#
# The popup does not need the workspace passed to it. Unlike `fleet-ls`, which
# runs in the plugin root and has to be told where to look, a plugin pane
# receives $HERDR_PLUGIN_CONTEXT_JSON of its own; the dashboard reads the
# workspace cwd from there.

set -eu

herdr_bin=${HERDR_BIN_PATH:-herdr}
plugin=${HERDR_PLUGIN_ID:-andyhite.fleet}
# How long to keep trying for the popup slot. Seconds, because the deadline is
# computed from `date +%s` and this is the only bound in the script.
budget=${FLEET_DASHBOARD_OPEN_TIMEOUT_S:-3}

# A popup is a singleton session resource, and the command palette is itself a
# popup — so the palette, which is the advertised way to reach this action, is
# still holding the slot at the moment it dispatches us. herdr answers
# `plugin_pane_open_failed` / "popup already open", the palette closes a beat
# later, and the second attempt lands.
#
# Only a modal in the way is retried. A misconfigured entrypoint or a disabled
# plugin should fail on the first attempt rather than after the whole budget.
transient() {
  case $1 in
    *'popup already open'*|*ui_busy*) return 0 ;;
    *) return 1 ;;
  esac
}

open_popup() { "$herdr_bin" plugin pane open --plugin "$plugin" --entrypoint dashboard 2>&1; }

# An absolute deadline rather than a countdown of sleeps: the loop body is a
# herdr round trip of its own, and accumulating only the time spent asleep is
# how a bound gets overrun by an order of magnitude.
deadline=$(( $(date +%s) + budget ))
while :; do
  if out=$(open_popup); then exit 0; fi
  transient "$out" || break
  [ "$(date +%s)" -lt "$deadline" ] || break
  sleep 0.1
done

# An action that fails silently looks like a broken binding.
#
# The plugin log is the reliable half of the report: `notification show` is a
# no-op unless the user has turned toasts on (`ui.toast.delivery` defaults to
# `off`), so it is attempted rather than relied on. herdr's own message goes in
# the body, since "which modal" is the thing you need to know; the body is
# capped at 240 characters.
printf 'fleet-dashboard-open: %s\n' "$out" >&2
"$herdr_bin" notification show 'Fleet dashboard' \
  --body "Could not open: $(printf '%.200s' "$out")" \
  --position top-right >/dev/null 2>&1 || true
exit 1
