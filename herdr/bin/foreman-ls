#!/bin/sh
# `foreman ls` for the herdr command palette.
#
# Plugin actions run with cwd set to the plugin root, but `foreman ls` scopes its
# inventory to the repo it is invoked from — so calling it directly here would
# always report on this plugin's own checkout instead of the workspace the user
# is looking at. herdr passes that workspace in HERDR_PLUGIN_CONTEXT_JSON.

set -eu

# `foreman` itself checks for jq, but the parse below runs first — without this
# a missing jq makes the action fail with an empty context and no explanation.
command -v jq >/dev/null 2>&1 \
  || { printf 'foreman-ls: jq is required but not on PATH\n' >&2; exit 1; }

dir=$(CDPATH='' cd -P "$(dirname "$0")" && pwd)

if ! cwd=$(printf '%s' "${HERDR_PLUGIN_CONTEXT_JSON:-}" | jq -r '.workspace_cwd // empty' 2>/dev/null); then
  printf 'foreman-ls: could not parse HERDR_PLUGIN_CONTEXT_JSON\n' >&2
  exit 1
fi
if [ -n "$cwd" ] && [ -d "$cwd" ]; then
  cd "$cwd"
fi

exec "$dir/foreman" ls
