#!/usr/bin/env bash
# foreman — dispatch peer coding agents into herdr worktree workspaces.
#
# The problem this solves: local subagents (`task` in omp) live inside one
# harness process, so they share its context window, cwd, and lifetime. Work
# that wants a real branch, a real checkout, and an agent you can still talk to
# an hour later needs a separate agent process. herdr already has every
# primitive for that (`worktree create`, `agent start/prompt/read/wait`), but
# stringing them together per dispatch is several commands, a JSON dig, and
# knowing which of them yields an agent herdr will actually recognise and
# address. This is that sequence, done once, correctly.
#
# The other half is addressing. Harness-local direct channels do not cross
# process boundaries, so every message between boss and worker rides
# herdr's agent surface instead. `herdr agent prompt <name>` writes into a live
# agent's input, which
# means the channel is symmetric: a worker answers its boss with the
# same command the boss used to reach it. What each side needs to know
# about the other lives under $FOREMAN_STATE, keyed by herdr agent name, so
# nothing is written into the repo and no environment has to be injected.
#
# Vocabulary: the BOSS (default handle: the repo root's name) is
# `foreman boss`. A WORKER is an agent `foreman spawn` created. A HANDLE is a herdr
# agent name — `[a-z][a-z0-9_-]{0,31}` — and is the only identifier used here;
# workspace and pane IDs stay inside this script.

set -euo pipefail

FOREMAN_STATE="${FOREMAN_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/foreman}"

# Bound on getting a named, input-ready agent into a fresh worktree. `agent
# start` blocks until herdr has detected the selected harness, so this covers
# the agent's own boot; herdr caps its --timeout at 300000 and the value is
# clamped to that.
SPAWN_TIMEOUT_MS="${FOREMAN_SPAWN_TIMEOUT_MS:-120000}"
# Bound on a single `foreman ask`/`foreman join`. Long by default: the whole point
# of a worker is that it does something substantial.
WAIT_TIMEOUT_MS="${FOREMAN_WAIT_TIMEOUT_MS:-3600000}"
# A prompt that never lands is worse than a failed one: `foreman join` then waits
# on an agent that is idle for the wrong reason. herdr only fails a stalled
# prompt under `agent prompt --wait`, and that waits for a *settled* state
# rather than a started one, so the check has to live here — on the state the
# agent actually reached after submission.
DISPATCH_SETTLE_MS="${FOREMAN_DISPATCH_SETTLE_MS:-15000}"
# Commands the `full` layout runs beside the agent. Overridable because they
# are a preference, not a mechanism.
FOREMAN_EDITOR="${FOREMAN_EDITOR:-nvim}"
FOREMAN_GIT_UI="${FOREMAN_GIT_UI:-lazygit}"
# Model tier applied when `foreman spawn` names neither `--tier` nor `--model`.
# Empty keeps today's behaviour: the harness's own default model. The agent
# plugin's commands print an explicit `--tier`, so this is only a boss-side
# default.
FOREMAN_AGENT_TIER="${FOREMAN_AGENT_TIER:-}"
# A new shell may still be loading zsh/mise/direnv when a layout command is
# sent. Verify that the requested TUI actually became foreground and retry.
LAYOUT_START_TIMEOUT_MS="${FOREMAN_LAYOUT_START_TIMEOUT_MS:-15000}"
# How often `foreman join` re-reads every worker it is watching. One `agent list`
# covers the whole wave per tick, so this is cheap; it only bounds how quickly
# a settled worker or a filed question is noticed.
JOIN_POLL_MS="${FOREMAN_JOIN_POLL_MS:-2000}"

die() { printf 'foreman: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"; }

require_herdr() {
  [ "${HERDR_ENV:-}" = 1 ] || die "not running inside herdr (HERDR_ENV is unset)"
  need herdr
  need jq
}

# herdr prints JSON on stdout and JSON errors on stderr with exit 1. The two
# streams are captured separately: folding stderr into stdout would let any
# warning herdr writes on a *successful* call land in the JSON that callers
# hand to jq. Surfacing the raw payload still beats a generic failure message.
h() {
  local out err errfile rc=0
  errfile=$(mktemp) || die "mktemp failed"
  out=$(herdr "$@" 2>"$errfile") || rc=$?
  err=$(cat "$errfile")
  rm -f "$errfile"
  if [ "$rc" != 0 ]; then
    die "herdr $* failed: ${err:-$out}"
  fi
  printf '%s' "$out"
}

# Best-effort delivery to another pane, the deliberate opposite of `h`: a push
# that cannot land must not fail the command that made it. Every caller has
# already written the state file a `foreman join` collects from, so a boss that
# is not live and a payload herdr rejects both degrade to that same fallback.
#
# The exit code is a delivery *contract*, not a success flag, because only one
# of the two paths actually moves the text:
#
#   0  the text is in the agent's session (herdr prompt). The caller must stamp
#      its acknowledgement counter, or the boss's own sweep hands the same
#      report over a second time.
#   2  a doorbell was rung and nothing else. The payload still sits on disk for
#      `foreman pickup` to read, so the caller must NOT stamp: the only
#      delivery that matters has not happened yet.
#   1  neither — no live pane. Filed for a later `foreman join`.
#
# Collapsing 2 into 0 is what silently ate every pushed report and question:
# the worker rang the bell, stamped the delivery as collected on the strength
# of `kill` succeeding, and the boss's pickup then skipped it as already
# handed over. `dispatch_to` (:1613, :1636) always had this right for tasks.
notify_agent() {
  local handle=$1 text=$2 pane
  # The pane doubles as the existence check: agent_exists() is this same
  # lookup, so resolving it here instead of calling both keeps a push at the
  # one herdr round trip it cost before the bus existed.
  pane=$(agent_field "$handle" pane_id)
  [ -n "$pane" ] || return 1
  # A rung doorbell means the extension will inject this via `foreman pickup`
  # instead: prompting on top of it would double-inject the same text, once as
  # a herdr prompt and once as the aside.
  if bus_signal "$pane"; then return 2; fi
  herdr agent prompt "$handle" "$text" >/dev/null 2>&1
}

# ── Timing ───────────────────────────────────────────────────────────────────
#
# Every bound in this file is wall-clock, computed as an absolute deadline up
# front. Accumulating sleep intervals instead — `waited=$((waited + 500))` —
# counts only the time spent asleep, so a loop whose body blocks on a herdr
# call carrying its own multi-second timeout overruns its budget by orders of
# magnitude. `start_worker_agent` did exactly that: a 120s bound bounded 240
# iterations of a call that could itself take 120s.
#
# Second resolution is deliberate. bash 3.2 has no $EPOCHREALTIME, and every
# budget here is seconds to minutes.

deadline_ms() { printf '%s' "$(( $(date +%s) + ($1 + 999) / 1000 ))"; }
expired() { [ "$(date +%s)" -ge "$1" ]; }

# Milliseconds left on a deadline, floored at zero. Used to hand an inner
# herdr call what remains of the budget rather than the whole of it.
remaining_ms() {
  local left=$(( ($1 - $(date +%s)) * 1000 ))
  [ "$left" -gt 0 ] || left=0
  printf '%s' "$left"
}

# Keeps the millisecond units of the constants above from leaking into every
# call site. `sleep` takes a decimal on both platforms foreman supports.
sleep_ms() { sleep "$(( $1 / 1000 )).$(printf '%03d' "$(( $1 % 1000 ))")"; }

# ── Handles ──────────────────────────────────────────────────────────────────

# herdr's name grammar is stricter than a branch name, so a branch has to be
# reduced rather than escaped: `feat/1234-add-Widget_v2` -> `feat-1234-add-widget-v2`.
#
# `sed -E` is load-bearing. BSD sed (what macOS ships) does not understand `\+`
# in a basic regex — it matches a literal plus, so the whole substitution
# silently becomes a no-op and the branch name passes through with its slashes
# intact. That produces both an invalid herdr agent name and a worktree path
# with a phantom directory level in it.
slugify() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E -e 's/[^a-z0-9]+/-/g' -e 's/^-+//' -e 's/-+$//')
  if [ -z "$s" ]; then
    # Nothing survived the reduction (a branch like `---`). Every such branch
    # would otherwise collapse onto the same handle, so key them by checksum
    # rather than letting them collide.
    s="w-$(printf '%s' "$1" | cksum | tr -cd '0-9' | cut -c1-8)"
  else
    # A leading digit is legal in a branch and illegal in a herdr agent name.
    case "$s" in [a-z]*) ;; *) s="w-$s" ;; esac
  fi
  # Truncating can leave a trailing hyphen, which the grammar also rejects.
  printf '%.32s' "$s" | sed -E -e 's/-+$//'
}

# This pane's own agent handle. Every foreman command a worker runs resolves its
# identity this way, which is why no env var has to be injected at spawn.
self_handle() {
  [ -n "${HERDR_PANE_ID:-}" ] || die "HERDR_PANE_ID is unset; not in a herdr pane"
  h agent list | jq -r --arg p "$HERDR_PANE_ID" \
    '(.result.agents[]? | select(.pane_id == $p) | .name) // empty'
}

agent_field() {
  h agent list | jq -r --arg n "$1" --arg f "$2" \
    '(.result.agents[]? | select(.name == $n) | .[$f]) // empty'
}

agent_exists() { [ -n "$(agent_field "$1" pane_id)" ]; }

# herdr's agent-name grammar: [a-z][a-z0-9_-]{0,31}.
#
# LC_ALL=C is load-bearing. A glob range is collation-ordered, and most locales
# interleave case (aAbBcC…), so under the bash 3.2 macOS ships `[a-z]` matches
# `W` — `valid_handle Webapp` returned true and the name went on to be rejected
# by herdr itself, after the worktree it was supposed to guard already existed.
# Under C the ranges are byte ranges.
valid_handle() {
  local LC_ALL=C
  case "$1" in
    [a-z]*) ;;
    *) return 1 ;;
  esac
  case "$1" in *[!a-z0-9_-]*) return 1 ;; esac
  [ ${#1} -le 32 ]
}

# An unused variant of $1, for displacing whoever currently holds it. Clearing
# the holder's name instead would leave a live agent that nothing can address —
# not `foreman send`, not `foreman read`, not even its own `foreman whoami` — so a
# displaced agent is always moved to a name, never anonymized.
free_handle() {
  local base=$1 n=1 candidate
  # Leave room for the "-NN" suffix inside herdr's 32-character limit.
  base=$(printf '%.29s' "$base" | sed -E -e 's/-+$//')
  while [ "$n" -lt 100 ]; do
    candidate="$base-$n"
    if ! agent_exists "$candidate"; then printf '%s' "$candidate"; return 0; fi
    n=$((n + 1))
  done
  return 1
}

# Repo identity for scoping. $FOREMAN_STATE is machine-global, so without this a
# bare `foreman join` in one repo blocks on another repo's workers and
# `foreman reap --all` deletes their worktrees. The git *common* dir is the key
# rather than the toplevel, so a worktree groups with the repo it came from.
repo_key() {
  local dir=${1:-.} top common
  top=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$top" ] || return 0
  common=$(cd "$top" && git rev-parse --git-common-dir 2>/dev/null) || return 0
  [ -n "$common" ] || return 0
  ( cd "$top" && cd "$common" && pwd -P )
}

# Whether the enabled workspace-manager plugin declares this repo, or the
# worktree foreman is about to create inside it. This is the deterministic
# coexistence gate: a covered repo belongs to the plugin for as long as it is
# enabled; every other repo belongs to foreman. Letting both race and inferring
# ownership from who started the agent first has an inverse race where the
# loser can still apply its layout afterwards.
#
# $FOREMAN_IGNORE_WORKSPACE_MANAGER=1 turns the gate off. Refusing outright left
# a covered repo unusable by foreman without editing a *different* plugin's
# global config — a heavy price for a race the operator may know does not
# apply, since a layout with no `agent:` pane never contends for one.
WSM_PLUGIN_ID=herdr-plugin-workspace-manager

workspace_manager_enabled() {
  herdr plugin list --json 2>/dev/null \
    | jq -e --arg id "$WSM_PLUGIN_ID" \
        'any(.result.plugins[]?; .plugin_id == $id and .enabled == true)' \
      >/dev/null 2>&1
}

# The plugin's own config lookup, in its own order: $HERDR_WSM_CONFIG wins
# outright, then the herdr-managed config dir, then its legacy path under
# ~/.herdr. Checking only the middle one — which is what foreman used to do —
# reports "not covered" for a repo the plugin is in fact managing.
workspace_manager_config() {
  local dir f
  if [ -n "${HERDR_WSM_CONFIG:-}" ]; then
    [ -f "$HERDR_WSM_CONFIG" ] || return 1
    printf '%s' "$HERDR_WSM_CONFIG"; return 0
  fi
  dir=$(herdr plugin config-dir "$WSM_PLUGIN_ID" 2>/dev/null || true)
  if [ -n "$dir" ]; then
    for f in "$dir/config.yml" "$dir/config.yaml"; do
      [ -f "$f" ] && { printf '%s' "$f"; return 0; }
    done
  fi
  f="$HOME/.herdr/plugins/$WSM_PLUGIN_ID/config.yml"
  [ -f "$f" ] && { printf '%s' "$f"; return 0; }
  return 1
}

# `<key>\t<value>` for every `repo:` and `path:` under the top-level
# `workspaces:` block. A YAML subset, like the plugin's own parser — but
# scoped to the right block, where a global `sed` for `- repo:` matches a
# `repo:` key anywhere in the file. It also reads `path:`, which the previous
# parser ignored entirely: `path:` is a documented alternative to `repo:`, so
# skipping it silently reported covered repos as uncovered.
workspace_manager_entries() {
  awk '
    function emit(key, line) {
      sub(/[[:space:]]+#.*$/, "", line)
      sub(/^[^:]*:[[:space:]]*/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line != "") print key "\t" line
    }
    # Column zero is top level: entering `workspaces:` arms us, any other
    # top-level key disarms us again.
    /^[^[:space:]#]/ { inws = ($0 ~ /^workspaces[[:space:]]*:/); next }
    !inws { next }
    /^[[:space:]]*(-[[:space:]]*)?repo[[:space:]]*:/ { emit("repo", $0); next }
    /^[[:space:]]*(-[[:space:]]*)?path[[:space:]]*:/ { emit("path", $0); next }
  ' "$1"
}

workspace_manager_covers() {
  local repo=$1 wtpath=$2 config repo_id kind value candidate

  if [ "${FOREMAN_IGNORE_WORKSPACE_MANAGER:-}" = 1 ]; then return 1; fi
  workspace_manager_enabled || return 1
  config=$(workspace_manager_config) || return 1
  repo_id=$(repo_key "$repo")

  while IFS=$'\t' read -r kind value; do
    [ -n "$value" ] || continue
    case "$value" in
      \"*\") value=${value#\"}; value=${value%\"} ;;
      \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    case "$value" in \~/*) value="$HOME/${value#\~/}" ;; esac
    case "$kind" in
      repo)
        # `repo` accepts a path (including ~) or a bare repo name.
        case "$value" in
          */*)
            candidate=$(repo_key "$value")
            [ -n "$candidate" ] && [ "$candidate" = "$repo_id" ] && return 0
            ;;
          *) [ "$(basename "$repo")" = "$value" ] && return 0 ;;
        esac
        ;;
      path)
        # The plugin prefix-matches a worktree's *checkout* path, so the thing
        # to compare is the path foreman is about to create — not the repo it
        # branches from. It does not exist yet, so this is a string prefix
        # rather than a resolved one.
        value=${value%/}
        case "$wtpath" in "$value"|"$value"/*) return 0 ;; esac
        ;;
    esac
  done <<EOF
$(workspace_manager_entries "$config")
EOF
  return 1
}

# ── State ────────────────────────────────────────────────────────────────────
#
# One directory per worker under $FOREMAN_STATE. `meta` is sourced, so values are
# written through printf %q. `report.md` is the worker's deliverable: herdr can
# only scrape a pane's scrollback, and omp runs on the alternate screen where
# scrollback does not survive, so a file is the only reliable transport for a
# report of any length.

meta_dir() { printf '%s/%s' "$FOREMAN_STATE" "$1"; }
meta_file() { printf '%s/meta' "$(meta_dir "$1")"; }
report_file() { printf '%s/report.md' "$(meta_dir "$1")"; }
# Holds a counter bumped immediately before every dispatch, so a report can be
# matched against the dispatch it answers. That is what keeps a follow-up
# `foreman send` from having to truncate the report the worker already filed just
# to avoid re-reading it.
#
# A counter rather than a timestamp: `test -nt` compares whole seconds under
# the bash 3.2 that macOS ships, so a worker reporting inside the same second
# as its dispatch read as stale — which made a fast task look like a dispatch
# that never landed.
dispatch_file() { printf '%s/dispatched' "$(meta_dir "$1")"; }
# The dispatch counter the current report answers, stamped by `foreman report`.
report_token_file() { printf '%s/report.token' "$(meta_dir "$1")"; }
# The question a worker filed with `foreman reply`, and the three counters that
# track its life: filed (seq), delivered to the boss (seen), answered by the
# boss (answered). One counter cannot serve both readers of it. A sweep must
# not re-deliver a question the worker already pushed, while a *blocking* join
# must still break out on one that is merely unanswered: a queued `agent
# prompt` does not reach a boss that is inside a blocking tool call, so the
# file is the only thing that can preempt a join — and "the boss has the text"
# is not the same fact as "the worker is no longer waiting on it".
question_file() { printf '%s/question.md' "$(meta_dir "$1")"; }
question_seq_file() { printf '%s/question.seq' "$(meta_dir "$1")"; }
question_seen_file() { printf '%s/question.seen' "$(meta_dir "$1")"; }
question_answered_file() { printf '%s/question.answered' "$(meta_dir "$1")"; }
# The dispatch counter `foreman join` last reported a settled result for. A bare
# `join` skips a worker whose settle has already been collected, so re-joining
# terminates instead of returning instantly, forever, on a worker that ended
# its turn without ever running `foreman report`.
joined_token_file() { printf '%s/joined' "$(meta_dir "$1")"; }
# The verbatim dispatch text (task + protocol block), mirrored beside
# `dispatched` so `foreman pickup` can hand a worker exactly what `h agent
# prompt` would have carried, without reconstructing it from the counter
# alone.
task_file() { printf '%s/task.md' "$(meta_dir "$1")"; }
# What `foreman pickup` has acked out of `dispatched`, following the same
# counter/token idiom as `report.token`: a plain "delivered" boolean cannot
# tell dispatch 2 (queued while pickup was mid-read of dispatch 1) apart from
# a redelivery of dispatch 1, so pickup acks the generation it actually read.
task_token_file() { printf '%s/task.seen' "$(meta_dir "$1")"; }
# Where a sidecar publishes itself, keyed by pane rather than by handle: it
# starts with its omp session, which is before `foreman boss` claims a handle
# at all, and `foreman boss --steal` can later move a handle to another pane.
# The pane is fixed for the life of the session and handle -> pane is herdr's
# own live answer, so nothing here can go stale. Dot-prefixed because
# known_workers() reads every directory under $FOREMAN_STATE as a worker
# handle and `*/` does not match a leading dot — a plain `sidecars/` would show
# up as a phantom worker in `foreman ls --all-repos`.
bus_sidecar_file() { printf '%s/.sidecars/%s' "$FOREMAN_STATE" "$1"; }

# The sidecar pid to ring for pane $1, or nothing.
#
# Both pids in the file must name live processes. Existence is never enough: a
# sidecar SIGKILLed before its EXIT trap ran leaves the file behind, and what
# gets sent below is SIGUSR1, whose default disposition is *terminate* — firing
# it at a recycled pid would kill an unrelated process. A sidecar is a child of
# its omp session and cannot outlive it, so for both lines to name live
# processes again two pids would have to be recycled at once.
bus_target() {
  local f pid="" session=""
  f=$(bus_sidecar_file "$1")
  [ -f "$f" ] || return 1
  # Read, not `sed -n 1p` twice: this is on the delivery path of every report.
  { IFS= read -r pid; IFS= read -r session; } <"$f" || :
  [ -n "$pid" ] && [ -n "$session" ] || return 1
  kill -0 "$pid" 2>/dev/null && kill -0 "$session" 2>/dev/null || return 1
  printf '%s' "$pid"
}

# Rings the doorbell for pane $1, true only if the signal was actually
# delivered. Liveness and delivery are deliberately the same act: a caller that
# checked first and signalled after would have a window in which the sidecar
# dies between the two, having already decided to skip the prompt fallback —
# which is exactly how a task used to reach nobody at all.
bus_signal() {
  local pid
  pid=$(bus_target "$1") || return 1
  kill -USR1 "$pid" 2>/dev/null
}

# Counters are compared as strings, never coerced to a number: "never
# dispatched" and "dispatched zero times" must compare equal to each other and
# unequal to everything else.
counter_read() { if [ -f "$1" ]; then cat "$1"; fi; }

counter_bump() {
  local f=$1 n
  mkdir -p "$(dirname "$f")"
  n=$(counter_read "$f")
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  printf '%s' "$((n + 1))" >"$f"
}

# Record one counter as acknowledged by copying it onto another. A missing
# source still leaves an empty file rather than no file: counter_read maps both
# to "", so the acknowledgement of a worker that was never dispatched has to be
# writable too, and `cp` of a nonexistent path is a fatal error under `set -e`.
counter_ack() {
  mkdir -p "$(dirname "$2")"
  if [ -f "$1" ]; then cp "$1" "$2"; else : >"$2"; fi
}

meta_set() {
  local handle=$1; shift
  mkdir -p "$(meta_dir "$handle")"
  local f; f=$(meta_file "$handle")
  : >"$f"
  local kv
  for kv in "$@"; do
    printf '%s=%q\n' "${kv%%=*}" "${kv#*=}" >>"$f"
  done
}

# Rewrite one key, preserving every other line. meta_set() truncates, so using
# it to change a single field means restating all of them — and a field it
# forgot would be silently dropped.
meta_update() {
  local handle=$1 kv=$2
  local key=${kv%%=*} val=${kv#*=}
  local f; f=$(meta_file "$handle")
  [ -f "$f" ] || return 0
  local tmp="$f.tmp" line
  : >"$tmp"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$key="*) continue ;; esac
    printf '%s\n' "$line" >>"$tmp"
  done <"$f"
  printf '%s=%q\n' "$key" "$val" >>"$tmp"
  mv "$tmp" "$f"
}

meta_get() {
  local f; f=$(meta_file "$1")
  [ -f "$f" ] || return 0
  # The key is unset inside the subshell before the file is sourced. `${!2}`
  # otherwise falls through to the *environment* for a key the file does not
  # carry, so a meta file written before REPO_KEY existed would silently read
  # $REPO_KEY from the caller's environment and mis-scope every repo-scoped
  # command.
  ( unset "$2" 2>/dev/null || true
    set -a; # shellcheck disable=SC1090
    . "$f"; printf '%s' "${!2:-}" )
}

# ── Boss identity ────────────────────────────────────────────────────

# The handle `foreman boss` claims when none is named. A constant default would
# let exactly one repo on the machine ever hold it, since herdr agent names are
# unique across the whole herdr session; the repo root's name gives every
# checkout a default of its own, and still collides — correctly — with a second
# boss in the same one. $FOREMAN_BOSS_HANDLE overrides.
default_boss() {
  if [ -n "${FOREMAN_BOSS_HANDLE:-}" ]; then
    printf '%s' "$FOREMAN_BOSS_HANDLE"; return 0
  fi
  local top
  top=$(git rev-parse --show-toplevel 2>/dev/null) || true
  if [ -n "$top" ]; then slugify "$(basename "$top")"; else printf 'boss'; fi
}

cmd_boss() {
  require_herdr
  local steal=0 name=""
  while [ $# -gt 0 ]; do
    case $1 in
      --steal) steal=1; shift ;;
      -*) die "usage: foreman boss [name] [--steal]" ;;
      *) name=$1; shift ;;
    esac
  done

  local current; current=$(self_handle)
  # With no argument this is a query, not a claim: a pane that already has a
  # handle keeps it.
  if [ -z "$name" ]; then
    if [ -n "$current" ]; then printf '%s\n' "$current"; return 0; fi
    name=$(default_boss)
  fi
  if [ "$current" = "$name" ]; then
    printf '%s\n' "$name"; return 0
  fi
  valid_handle "$name" || die "handle '$name' is not a valid herdr agent name"

  # A name is unique among live agents and follows the pane occupant, so a
  # handle held elsewhere is a live collision, not a stale record. Two repos
  # each wanting a foreman is the ordinary case, so say how to get out of it
  # instead of just refusing.
  local holder; holder=$(agent_field "$name" pane_id)
  if [ -n "$holder" ]; then
    [ "$steal" = 1 ] || die "handle '$name' is held by pane $holder
  use another handle:  foreman boss <name>
  or take it over:     foreman boss $name --steal   (moves $holder aside)"
    local moved
    moved=$(free_handle "$name") \
      || die "cannot free '$name': every variant of it is already in use"
    h agent rename "$holder" "$moved" >/dev/null
    note "foreman: moved the previous '$name' (pane $holder) to '$moved'"
    rebind_boss "$name" "$moved"
  fi
  h agent rename "$HERDR_PANE_ID" "$name" >/dev/null
  # A pane can already be named without ever having been a boss —
  # workspace-manager's layout starts agents as `omp-<workspace>` — so renaming
  # is a normal path, not an error. What is not acceptable is leaving workers
  # pointing at a handle nobody answers to any more: the live agent name is the
  # source of truth, so their records follow it.
  [ -z "$current" ] || rebind_boss "$current" "$name"
  printf '%s\n' "$name"
}

# Repoint every worker that reports to $1 at $2. Deliberately unscoped by repo:
# a handle is unique across the machine, so every record naming it means the
# same agent, wherever its worktree lives.
rebind_boss() {
  local from=$1 to=$2 handle n=0
  [ -n "$from" ] && [ "$from" != "$to" ] || return 0
  for handle in $(known_workers); do
    [ "$(meta_get "$handle" BOSS)" = "$from" ] || continue
    meta_update "$handle" "BOSS=$to"
    n=$((n + 1))
  done
  [ "$n" = 0 ] || note "foreman: repointed $n worker(s) from '$from' to '$to'"
}

cmd_whoami() {
  require_herdr
  local me; me=$(self_handle)
  [ -n "$me" ] || die "this pane has no herdr agent name; run 'foreman boss' first"
  printf '%s\n' "$me"
}

cmd_doctor() {
  local failed=0

  # 1. HERDR_ENV = 1
  if [ "${HERDR_ENV:-}" = 1 ]; then
    printf '%-6s %s\n' 'ok' 'inside herdr'
  else
    printf '%-6s %s\n' 'fail' 'not inside herdr (HERDR_ENV is unset)'
    failed=1
  fi

  # 2. command -v herdr
  if command -v herdr >/dev/null 2>&1; then
    printf '%-6s %s\n' 'ok' "$(herdr --version 2>/dev/null | head -1) on PATH"
  else
    printf '%-6s %s\n' 'fail' 'herdr not found on PATH'
    failed=1
  fi

  # 3. command -v jq
  if command -v jq >/dev/null 2>&1; then
    printf '%-6s %s\n' 'ok' 'jq found'
  else
    printf '%-6s %s\n' 'fail' 'jq not found on PATH'
    failed=1
  fi

  # 4. HERDR_PANE_ID set
  if [ -n "${HERDR_PANE_ID:-}" ]; then
    printf '%-6s %s\n' 'ok' 'HERDR_PANE_ID is set'
  else
    printf '%-6s %s\n' 'warn' 'HERDR_PANE_ID is unset (foreman report/reply/boss need a pane; run: foreman boss)'
  fi

  # 5. Only if checks 1-4 all passed: self_handle non-empty
  if [ "$failed" = 0 ]; then
    local me; me=$(self_handle 2>/dev/null) || true
    if [ -n "$me" ]; then
      printf '%-6s %s\n' 'ok' "agent handle: $me"
    else
      printf '%-6s %s\n' 'warn' 'this pane has no agent handle (run: foreman boss)'
    fi
  fi

  # 6. $FOREMAN_STATE writable
  local probe_file
  if mkdir -p "$FOREMAN_STATE" 2>/dev/null && probe_file=$(mktemp "$FOREMAN_STATE/.probe.XXXXXX" 2>/dev/null) && rm -f "$probe_file" 2>/dev/null; then
    printf '%-6s %s\n' 'ok' "$FOREMAN_STATE is writable"
  else
    printf '%-6s %s\n' 'fail' "$FOREMAN_STATE is not writable"
    failed=1
  fi

  # 7. command -v foreman resolves
  if command -v foreman >/dev/null 2>&1; then
    printf '%-6s %s\n' 'ok' "foreman at $(command -v foreman)"
  else
    printf '%-6s %s\n' 'warn' 'foreman not on PATH (run foreman-link or add ~/.local/bin to PATH)'
  fi

  # 8. Inside a git repo (repo_key non-empty)
  local key; key=$(repo_key 2>/dev/null) || true
  if [ -n "$key" ]; then
    local count; count=$(known_workers "$key" 2>/dev/null | wc -l | tr -d ' ')
    printf '%-6s %s\n' 'ok' "registered workers for this repo: $count"
  else
    printf '%-6s %s\n' 'warn' 'not in a git repo (repo-scoped commands need a repo)'
  fi

  # 9. --role config, if any (optional: --role/--skill work without one)
  local rc; rc=$(foreman_config 2>/dev/null) || true
  if [ -n "$rc" ]; then
    printf '%-6s %s\n' 'ok' "role config at $rc"
  else
    printf '%-6s %s\n' 'warn' 'no role config found (--role unusable; --skill still works — run: foreman init)'
  fi

  # 10. Bus sidecar for this pane.
  #
  # The one failure this tool existed to explain and could not see: with no
  # live sidecar every report, question and dispatch still arrives, but as an
  # interrupting `herdr agent prompt` instead of an aside. Nothing errors, so
  # the only symptom is agents that feel like they interrupt each other. That
  # is a warning rather than a failure — the fallback is a supported path, and
  # a session outside herdr has no pane to ring at all.
  #
  # Missing and stale are reported apart because the fixes differ: missing
  # means no plugin declared the server for this session (restart it), stale
  # means a sidecar died without its EXIT trap running (nothing to do; the
  # record is reclaimed on the next publish).
  if [ -n "${HERDR_PANE_ID:-}" ]; then
    local bus_me bus_file bus_pid
    bus_me=$(self_handle 2>/dev/null) || true
    bus_file=$(bus_sidecar_file "$HERDR_PANE_ID")
    # Delivery resolves a handle to a pane and rings that pane's sidecar, so a
    # pane herdr does not list as an agent is unreachable by construction and
    # the sidecar question is moot. Keying this on HERDR_PANE_ID instead — set
    # in every pane, shell panes included — warned a plain shell that it was
    # missing a sidecar it could never have, and told it to restart a session
    # that was not running. A record with no handle still reports: that is an
    # agent pane herdr has since forgotten, and a stale record there is real.
    if [ -n "$bus_me" ] || [ -f "$bus_file" ]; then
      if bus_pid=$(bus_target "$HERDR_PANE_ID"); then
        printf '%-6s %s\n' 'ok' "bus sidecar live (pid $bus_pid); reports and dispatches arrive as asides"
      elif [ -f "$bus_file" ]; then
        printf '%-6s %s\n' 'warn' 'bus sidecar record is stale; delivery falls back to an interrupting prompt'
      else
        printf '%-6s %s\n' 'warn' 'no bus sidecar for this pane; delivery falls back to an interrupting prompt (is the omp plugin loaded? restart the session)'
      fi
    fi
  fi

  [ "$failed" = 0 ]
}

# Resolve who to report to. A worker learns this from its own meta file, which
# `foreman spawn` wrote before the worker existed.
boss_handle() {
  local me; me=$(self_handle)
  local b=""
  [ -n "$me" ] && b=$(meta_get "$me" BOSS)
  printf '%s' "${b:-$(default_boss)}"
}

# ── Skills ───────────────────────────────────────────────────────────────────
#
# Workers are always omp, and `skill://<name>` is omp's own first-class skill
# activation path — its system prompt instructs reading it directly. Foreman's
# only remaining job is validating the name before it goes into a dispatched
# prompt.

# A skill name becomes part of a `skill://` URI below. Agent Skills names are
# lowercase, at most 64 characters, and use hyphens as separators.
#
# LC_ALL=C is load-bearing for the same reason it is in valid_handle(): a glob
# range is collation-ordered, and most locales interleave case, so under the
# bash 3.2 macOS ships `[a-z]` matches `I` and `Implement` passed as a name.
valid_skill_name() {
  local LC_ALL=C
  local name=$1
  [ -n "$name" ] && [ ${#name} -le 64 ] || return 1
  case "$name" in [a-z0-9]*) ;; *) return 1 ;; esac
  case "$name" in *[!a-z0-9-]*|*-) return 1 ;; esac
}

# Worker model tiers are labels that the agent plugin's commands may print. The
# mapping onto omp's own `--model` selectors lives only here — the plugin must
# not name `@task`, `@default`, or any other omp-specific selector.
valid_agent_tier() {
  case "$1" in standard|deep) return 0 ;; *) return 1 ;; esac
}

# A model selector becomes an `herdr agent start … --` argument. Keep it to one
# shell-safe token so a crafted value cannot inject further flags; the harness
# remains the authority on whether the selector is a real model.
valid_agent_model() {
  local LC_ALL=C
  local model=$1
  [ -n "$model" ] && [ ${#model} -le 128 ] || return 1
  case "$model" in -*) return 1 ;; esac
  case "$model" in *[!a-zA-Z0-9@/_:.+-]*) return 1 ;; esac
}

# Print the argv that follows `herdr agent start … --`, one token per line.
# `--model` wins by construction (callers treat the two flags as mutually
# exclusive); `--tier` maps onto omp's own model selectors.
worker_agent_args() {
  local tier=$1 model=$2
  if [ -n "$model" ]; then
    printf '%s\n' --model "$model"
    return 0
  fi
  [ -n "$tier" ] || return 0
  case "$tier" in
    standard) printf '%s\n' --model '@task' ;;
    deep)     printf '%s\n' --model '@default' ;;
  esac
}

# Resolve through the PATH symlink herdr installs, so foreman_version and
# cmd_dashboard can find files that live beside this script regardless of the
# caller's cwd.
foreman_script_dir() {
  local path=${BASH_SOURCE[0]} dir target
  while [ -L "$path" ]; do
    dir=$(cd -P "$(dirname "$path")" && pwd)
    target=$(readlink "$path")
    case "$target" in /*) path=$target ;; *) path="$dir/$target" ;; esac
  done
  cd -P "$(dirname "$path")" && pwd
}

foreman_version() {
  local toml; toml="$(foreman_script_dir)/../herdr-plugin.toml"
  [ -f "$toml" ] || { printf 'unknown'; return 0; }
  awk '/^[[:space:]]*\[/ { exit } /^[[:space:]]*version[[:space:]]*=/ { gsub(/[" ]/, ""); sub(/^version=/, ""); print; exit }' "$toml"
}

cmd_version() { printf 'foreman %s\n' "$(foreman_version)"; }

# Introspection for --role: where foreman's config was found (if at all) and
# what it maps. Exists because a missing or misspelled role only surfaces at
# spawn time otherwise, and the error there cannot show the whole mapping.
cmd_roles() {
  local config
  if ! config=$(foreman_config); then
    printf 'no foreman config found (checked $FOREMAN_CONFIG and .foreman/config.yml at the repo root); run: foreman init\n'
    return 0
  fi
  local entries; entries=$(role_entries "$config")
  if [ -z "$entries" ]; then
    printf 'config at %s has no roles: entries\n' "$config"
    return 0
  fi
  printf 'roles (%s):\n' "$config"
  local name value spec model skill tag desc
  while IFS=$'\t' read -r name value; do
    spec=$(role_value_spec "$value")
    model=$(role_value_model "$value")
    skill=$(role_value_skill "$spec")
    tag=""
    [ "$(role_value_type "$spec")" = command ] && tag=" (command)"
    [ -n "$model" ] && tag="$tag [$model]"
    printf '  %-20s -> %s%s\n' "$name" "$skill" "$tag"
    if desc=$(skill_description "$skill"); then
      printf '      %s\n' "$desc"
    fi
  done <<EOF
$entries
EOF
}

# Scaffolds the project-local config `foreman roles`/`--role` read from.
# Deliberately does not touch anything under $FOREMAN_STATE and does not
# require a herdr pane: unlike every other cmd_*, this only ever writes one
# file into the repo, so a user can run it once right after cloning.
cmd_init() {
  local root target
  root=$(project_root) || die "not in a git repo"
  [ -n "$root" ] || die "not in a git repo"
  target="$root/.foreman/config.yml"
  if [ -e "$target" ]; then
    printf 'foreman: %s already exists; leaving it alone\n' "$target"
    return 0
  fi
  mkdir -p "$root/.foreman" || die "could not create $root/.foreman"
  cat >"$target" <<'EOF'
# foreman project config — see `foreman roles` and skill://foreman-dispatch
#
# roles: maps a --role name (foreman spawn --role <name>, foreman_spawn
# { role }) to one skill, plus an optional model. Plain `name: skill` loads
# that skill as reference material before the worker's task, same as
# --skill. Prefix the value with `command:` to invoke the skill instead, the
# way omp's own /skill:<name> does — the worker's task becomes that
# command's argument text. Use `command:` for a skill marked
# disable-model-invocation: true (a slash command, not passive content);
# plain form for everything else. Append a second, space-separated token to
# pin the role to a model or omp modelRole selector (e.g. `@review`, see
# omp://models.md) — the same thing --tier/--model do for one spawn, kept
# with the role so it survives a model rename. An explicit --tier/--model
# at the call site still wins. Uncomment and edit to name this project's
# own conventions:
#
# roles:
#   review: code-review @review
#   implement: my-house-implement-skill
#   triage: command:triage
EOF
  printf 'foreman: created %s\n' "$target"
}

skill_instruction() {
  local name=$1
  valid_skill_name "$name" || die "invalid skill name '$name'"
  printf 'Before doing any other work, read `skill://%s` and follow it.' "$name"
}

# `command:` roles are not reference material to read passively — they are
# `disable-model-invocation` skills (triage, to-spec, an implement protocol)
# that expect to be invoked like omp's own `/skill:<name>` slash command, with
# the dispatched task as that command's argument text. Emitting the same
# `/skill:<name>` token `h agent prompt` sends triggers the identical parser
# omp uses for a human typing it: see omp://skills.md, "Skills vs slash
# commands". Only the leading token differs from `skill_instruction` above.
command_instruction() {
  local name=$1
  valid_skill_name "$name" || die "invalid skill name '$name'"
  printf '/skill:%s' "$name"
}

# ── Role → skill mapping ─────────────────────────────────────────────────────
#
# foreman has no opinion on how a worker does its job (see skill://foreman-dispatch)
# — but once a house convention has a name ("review", "implement"), spelling
# out its exact skill at every dispatch site invites drift the moment that
# skill is renamed. `--role` is that convention, resolved through foreman's own
# config rather than baked into the CLI, so repointing "review" at a different
# skill touches one line in one file instead of every dispatch site.

# Deliberately project-local, not machine-global: a `roles:` mapping is a
# house convention of one repo, and a global config would apply someone
# else's convention to every checkout on the machine. `foreman init` scaffolds
# the file this looks for.
project_root() { git rev-parse --show-toplevel 2>/dev/null; }

# $FOREMAN_CONFIG wins outright as an escape hatch (tests use it to inject a
# config without a real repo); otherwise the only place looked at is
# `.foreman/config.yml` under the current repo's toplevel, so the mapping
# travels with the checkout instead of living somewhere machine-global.
foreman_config() {
  local dir f
  if [ -n "${FOREMAN_CONFIG:-}" ]; then
    [ -f "$FOREMAN_CONFIG" ] || return 1
    printf '%s' "$FOREMAN_CONFIG"; return 0
  fi
  dir=$(project_root) || return 1
  [ -n "$dir" ] || return 1
  for f in "$dir/.foreman/config.yml" "$dir/.foreman/config.yaml"; do
    [ -f "$f" ] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

# `roles:` is a flat map, unlike workspace-manager's list of objects, so the
# parser only has to arm on the `roles:` key and emit each indented
# `name: value` line under it as `name<TAB>value`.
role_entries() {
  awk '
    function emit(line) {
      sub(/[[:space:]]+#.*$/, "", line)
      key = line
      sub(/^[[:space:]]+/, "", key)
      sub(/:.*/, "", key)
      val = line
      sub(/^[^:]*:[[:space:]]*/, "", val)
      sub(/[[:space:]]+$/, "", val)
      gsub(/^["'"'"']|["'"'"']$/, "", val)
      if (key != "" && val != "") print key "\t" val
    }
    /^[^[:space:]#]/ { inroles = ($0 ~ /^roles[[:space:]]*:/); next }
    !inroles { next }
    /^[[:space:]]+[^[:space:]#]+[[:space:]]*:/ { emit($0) }
  ' "$1"
}

role_skill() {
  local role=$1 config key value
  config=$(foreman_config) || return 1
  while IFS=$'\t' read -r key value; do
    [ "$key" = "$role" ] || continue
    printf '%s' "$value"
    return 0
  done <<EOF
$(role_entries "$config")
EOF
  return 1
}

# A role's raw config value is a skill name by default, but a `command:`
# prefix marks it as an invocable command instead (see command_instruction
# above) — the distinction omp://skills.md draws between passive reference
# content and a user-invoked entry point. Kept as two small case statements,
# not one function with an out-param: bash 3.2 has no clean way to return two
# strings, and both call sites only ever need one half.
role_value_type() {
  case "$1" in
    command:*) printf 'command' ;;
    *) printf 'skill' ;;
  esac
}

role_value_skill() {
  case "$1" in
    command:*) printf '%s' "${1#command:}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# A role's config value is "<spec>[ <model>]": the skill spec (parsed by
# role_value_type/role_value_skill above) as the first whitespace-delimited
# token, an optional model or omp modelRole selector (see omp://models.md,
# "Role aliases like @smol expand through settings.modelRoles") as the
# second — the same idea as `--role` for skills, applied to `--tier`/`--model`:
# a house convention ("review runs on the good model") survives a model
# rename without touching every dispatch site. `read` (not glob stripping)
# splits it: the second variable in a multi-var read absorbs the remainder
# with surrounding whitespace trimmed, which handles stray extra spaces a
# glob-based split would not.
role_value_spec() {
  local spec
  read -r spec _ <<EOF
$1
EOF
  printf '%s' "$spec"
}

role_value_model() {
  local spec model
  read -r spec model <<EOF
$1
EOF
  printf '%s' "$model"
}

# Best-effort "what is this role for" hint for `cmd_roles`: the mapped
# skill's own frontmatter `description:`, from wherever the skill actually
# lives. `roles:` only ever stores a name, not a reason — `/foreman:init`
# picks a role name because a skill's description justified it, but that
# reasoning was never persisted anywhere `foreman roles` could show later.
# Reading the description back out of the skill itself avoids a second,
# driftable copy of the same text in `.foreman/config.yml`.
skill_frontmatter_description() {
  local file=$1 desc
  [ -f "$file" ] || return 1
  desc=$(awk '
    NR == 1 && $0 !~ /^---[[:space:]]*$/ { exit }
    NR == 1 { next }
    /^---[[:space:]]*$/ { exit }
    /^description:[[:space:]]*/ {
      sub(/^description:[[:space:]]*/, "")
      sub(/[[:space:]]+#.*$/, "")
      print
      exit
    }
  ' "$file")
  case "$desc" in
    \"*\") desc=${desc#\"}; desc=${desc%\"} ;;
    \'*\') desc=${desc#\'}; desc=${desc%\'} ;;
  esac
  [ -n "$desc" ] || return 1
  printf '%s' "$desc"
}

# Checked in the same project-then-global, native/claude/agents order
# `/foreman:init` globs (see skill://foreman-boss, "Role config", and
# omp://skills.md) — not every provider omp itself supports, just the ones a
# hand-authored skill is actually likely to live under. First file found
# wins; a role naming a skill this lookup cannot find (loaded through a
# provider it does not know about, or not installed in this checkout at
# all) is a silent miss, not a failure — `cmd_roles` still lists the mapping.
skill_description() {
  local name=$1 root candidate
  root=$(project_root) || root=""
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    skill_frontmatter_description "$candidate" && return 0
  done <<EOF
${root:+$root/skills/$name/SKILL.md}
${root:+$root/.omp/skills/$name/SKILL.md}
${root:+$root/.claude/skills/$name/SKILL.md}
${root:+$root/.agent/skills/$name/SKILL.md}
${root:+$root/.agents/skills/$name/SKILL.md}
$HOME/.omp/agent/skills/$name/SKILL.md
$HOME/.claude/skills/$name/SKILL.md
$HOME/.agent/skills/$name/SKILL.md
$HOME/.agents/skills/$name/SKILL.md
EOF
  return 1
}

# ── Spawning ─────────────────────────────────────────────────────────────────

# The protocol block appended to every dispatched task. Workers are blank agent
# sessions with no orchestration instructions of their own, so the contract has
# to travel with the work.
protocol_block() {
  local handle=$1 boss=$2 branch=$3 dir=$4
  cat <<EOF

---
## Foreman protocol

You are foreman worker \`$handle\`, working in \`$dir\` on branch \`$branch\`.
Your boss is the agent \`$boss\`.

- Stay inside this worktree. Do not touch other checkouts of this repo.
- Commit your work on this branch when it is done. Do not push and do not open
  a PR unless the task above says to.
- When finished, write your report last: the \`foreman_report\` tool, or
  \`foreman report -f <file>\` / \`foreman report "<summary>"\` from a shell.
  Filing it delivers it to the boss; terminal output does not reach it.
- If you are blocked or need a decision, use the \`foreman_reply\` tool, or
  \`foreman reply "<question>"\`. It delivers the question to the boss and
  files it, so the answer comes back even if the boss was mid-task. Use it
  for questions, not progress updates.
- Peers: \`foreman ls\` lists the other workers; \`foreman dm <handle> "<text>"\`
  messages one directly. Use it to coordinate on a shared seam, not for status
  updates.
- Delegate substantial independent slices of your task to your own subagents
  instead of working serially.
EOF
}

usage_spawn() {
  cat >&2 <<'EOF'
usage: foreman spawn <branch> [options]

  --base <ref>        branch point (default: the repo's origin HEAD)
  --repo <path>       repo to branch from (default: current repo)
  --path <path>       worktree location (default: sibling <repo>-<slug>)
  --handle <name>     agent handle (default: derived from the branch)
  --tier <tier>       worker model tier: standard | deep
                      (default: $FOREMAN_AGENT_TIER, or omp's own default)
  --model <selector>  pass --model <selector> to omp (escape hatch;
                      mutually exclusive with --tier)
  --skill <name>      load this skill before the dispatched task; repeat for
                      each procedure the worker must follow
  --role <name>       load the skill foreman's config maps this role to; only
                      one role per spawn
  --layout <shape>    agent (default) | full — see below
  --task <text>       task to dispatch once the agent is ready
  --task-file <path>  read the task from a file ('-' for stdin)
  --no-dispatch       build the worktree, agent, and layout without a task
  --replace           reuse a handle whose record exists but whose agent is
                      gone: removes the recorded workspace, then respawns

tiers:
  standard  mid-high model for orchestration that mostly delegates (@task)
  deep      high model for judgement-heavy orchestration (@default)

layouts:
  agent   one pane, running the selected agent. All a worker needs.
  full    the agent with an editor beside it, plus shell and review tabs, for a
          worktree you intend to sit in yourself. $FOREMAN_EDITOR (nvim) and
          $FOREMAN_GIT_UI (lazygit) choose the commands.
EOF
  exit 2
}

cmd_spawn() {
  require_herdr
  local branch="" base="" repo="" wtpath="" handle="" task="" taskfile="" dispatch=1
  local layout=agent replace=0 role="" role_seen=0 skills_count=0 command_skill=""
  local -a skills=()
  local tier=$FOREMAN_AGENT_TIER model="" tier_explicit=0 role_model=""
  [ $# -gt 0 ] || usage_spawn
  branch=$1; shift
  case "$branch" in -*) usage_spawn ;; esac
  while [ $# -gt 0 ]; do
    case $1 in
      --base) base=${2:?}; shift 2 ;;
      --repo) repo=${2:?}; shift 2 ;;
      --path) wtpath=${2:?}; shift 2 ;;
      --handle) handle=${2:?}; shift 2 ;;
      --layout) layout=${2:?}; shift 2 ;;
      --tier) tier=${2:?}; tier_explicit=1; shift 2 ;;
      --model) model=${2:?}; shift 2 ;;
      --skill) skills[skills_count]=${2:?}; skills_count=$((skills_count + 1)); shift 2 ;;
      --role)
        [ "$role_seen" = 0 ] || die "--role may be specified only once"
        role=${2:?}; role_seen=1; shift 2 ;;
      --task) task=${2:?}; shift 2 ;;
      --task-file) taskfile=${2:?}; shift 2 ;;
      --no-dispatch) dispatch=0; shift ;;
      --replace) replace=1; shift ;;
      *) usage_spawn ;;
    esac
  done

  # Validated before anything is created, like the handle validity check.
  if [ -n "$task" ] && [ -n "$taskfile" ]; then
    die "--task and --task-file are mutually exclusive"
  fi
  if [ "$dispatch" = 0 ] && { [ -n "$task" ] || [ -n "$taskfile" ]; }; then
    die "--no-dispatch cannot be combined with --task or --task-file"
  fi

  case "$layout" in
    agent|full) ;;
    *) die "unknown layout '$layout' (expected: agent, full)" ;;
  esac
  local skill
  if [ "$skills_count" -gt 0 ]; then
    for skill in "${skills[@]}"; do
      valid_skill_name "$skill" || die "invalid skill name '$skill'"
    done
  fi
  [ -z "$role" ] || valid_skill_name "$role" \
    || die "invalid role name '$role'"
  if [ -n "$role" ]; then
    local role_value role_spec
    role_value=$(role_skill "$role") || die "role '$role' has no mapping in foreman's config
  add it under roles: in $(foreman_config 2>/dev/null || printf '.foreman/config.yml at the repo root — run: foreman init')"
    role_spec=$(role_value_spec "$role_value")
    role_model=$(role_value_model "$role_value")
    skill=$(role_value_skill "$role_spec")
    valid_skill_name "$skill" \
      || die "role '$role' maps to invalid skill name '$skill'"
    [ -z "$role_model" ] || valid_agent_model "$role_model" \
      || die "role '$role' maps to invalid model selector '$role_model'"
    # A command role is invoked, not read as reference material — it does not
    # join the plain skills[] instruction list (see command_instruction).
    if [ "$(role_value_type "$role_spec")" = command ]; then
      command_skill=$skill
    else
      if [ "$skills_count" -gt 0 ]; then
        skills=("$skill" "${skills[@]}")
      else
        skills[0]=$skill
      fi
      skills_count=$((skills_count + 1))
    fi
    # A role's model is a default, exactly like $FOREMAN_AGENT_TIER — an
    # explicit --tier/--model at the call site is a more specific signal and
    # must still win. Only fills in when neither flag was given.
    if [ -n "$role_model" ] && [ "$tier_explicit" = 0 ] && [ -z "$model" ]; then
      model=$role_model
      tier=""
    fi
  fi
  # Only an *explicit* `--tier` conflicts with `--model`. `$FOREMAN_AGENT_TIER` is
  # a default, and an explicit `--model` must override it — otherwise exporting
  # the documented env default makes the escape hatch unusable.
  if [ "$tier_explicit" = 1 ] && [ -n "$model" ]; then
    die "--tier and --model are mutually exclusive"
  fi
  # `--model` wins over an env-derived tier so meta TIER/MODEL stay coherent.
  [ -z "$model" ] || tier=""
  [ -z "$tier" ] || valid_agent_tier "$tier" \
    || die "unknown tier '$tier' (expected: standard, deep)"
  [ -z "$model" ] || valid_agent_model "$model" \
    || die "model selector '$model' is not a safe --model value"
  # Validated before anything is created, like the handle validity check
  # below: a bad --tier should die here, not after the worktree, agent, and
  # meta record already exist and need `foreman reap` to clean up.
  [ -z "$tier" ] || worker_agent_args "$tier" "" >/dev/null

  repo=${repo:-$(git rev-parse --show-toplevel 2>/dev/null || true)}
  [ -n "$repo" ] || die "not in a git repo and --repo was not given"
  repo=$(cd "$repo" && pwd -P)

  if [ -z "$base" ]; then
    # origin/HEAD is the branch the remote considers default; fall back to
    # whatever is checked out when the symbolic ref was never fetched.
    base=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    base=${base:-$(git -C "$repo" rev-parse --abbrev-ref HEAD)}
  fi

  handle=${handle:-$(slugify "$branch")}
  # Checked before anything is created: a rename that fails after the worktree
  # exists leaves an orphaned workspace with a nameless agent in it, which is
  # exactly the mess this tool exists to avoid.
  valid_handle "$handle" \
    || die "handle '$handle' is not a valid herdr agent name (pass --handle)"
  agent_exists "$handle" && die "handle '$handle' is already in use"

  # The sibling-directory convention, so a worktree is visible next to its repo
  # rather than buried in ~/.herdr/worktrees.
  wtpath=${wtpath:-$(dirname "$repo")/$(basename "$repo")-$(slugify "$branch")}
  # The path is recorded in meta and told to the worker before it exists, and
  # workspace_manager_covers prefix-matches it as a string, so a relative form
  # breaks both.
  case "$wtpath" in /*) ;; *) wtpath="$(pwd -P)/$wtpath" ;; esac

  # After the worktree path is known, because workspace-manager can be
  # configured by checkout path as well as by repo.
  if workspace_manager_covers "$repo" "$wtpath"; then
    die "workspace-manager is enabled and configured for $repo
  foreman will not race it or depend on it. Remove the entry from
  $(workspace_manager_config)
  or disable the plugin — or, if you know its layout starts no agent here,
  re-run with FOREMAN_IGNORE_WORKSPACE_MANAGER=1"
  fi

  # A record with no live agent is a worker that died, not a free handle.
  # Overwriting it — which an `agent_exists` check alone allows — repoints
  # BRANCH/DIR/WORKSPACE at the new worktree and strands the old one where no
  # foreman command can find it. Branches collapse onto the same handle easily
  # (`feat/x`, `feat_x` and `feat-x` all slugify to `feat-x`), so this is
  # reachable by accident rather than only by reuse.
  if [ -d "$(meta_dir "$handle")" ]; then
    if [ "$replace" != 1 ]; then
      die "handle '$handle' still has a foreman record for branch '$(meta_get "$handle" BRANCH)'
  its worktree: $(meta_get "$handle" DIR)
  reuse it:     foreman spawn $branch --replace
  or clear it:  foreman reap $handle            (removes the worktree)
                foreman reap $handle --forget   (leaves the worktree alone)"
    fi
    note "foreman: replacing the dead worker '$handle' ($(meta_get "$handle" BRANCH))"
    reap_one "$handle" 0 0 1 \
      || die "could not clear the old '$handle'; reap it yourself, then retry"
  fi

  if [ -n "$taskfile" ]; then
    if [ "$taskfile" = "-" ]; then task=$(cat); else task=$(cat "$taskfile"); fi
  fi

  if [ "$skills_count" -gt 0 ] || [ -n "$command_skill" ]; then
    local skill_flag='--skill'; [ -z "$role" ] || skill_flag='--role or --skill'
    [ "$dispatch" = 1 ] \
      || die "$skill_flag cannot be combined with --no-dispatch"
    [ -n "$task" ] \
      || die "$skill_flag requires --task or --task-file"
    local instructions=""
    for skill in "${skills[@]}"; do
      instructions=${instructions:+$instructions$'\n\n'}"$(skill_instruction "$skill")"
    done
    # The command token goes last, directly ahead of the task text, so it
    # reads as "/skill:<name> <task>" — the leading-form shape omp's own
    # /skill:<name> parser recognizes even with earlier prose in the message.
    if [ -n "$command_skill" ]; then
      instructions=${instructions:+$instructions$'\n\n'}"$(command_instruction "$command_skill")"
    fi
    task="$instructions"$'\n\n'"$task"
  fi

  # The spawner is the boss, by definition. boss_handle() would be wrong here:
  # it reads the caller's own BOSS record, and only workers have one, so a
  # boss that claimed a custom handle silently stamped the default
  # `boss` into every worker and their replies went to whoever held it.
  local boss; boss=$(self_handle)
  [ -n "$boss" ] || die "this pane has no herdr agent name; run 'foreman boss' first"

  note "foreman: creating $branch at $wtpath (from $base)"
  local created ws tab pane
  created=$(h worktree create --cwd "$repo" --branch "$branch" --base "$base" \
    --path "$wtpath" --no-focus)
  ws=$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty')
  tab=$(printf '%s' "$created" | jq -r '.result.tab.tab_id // empty')
  pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$ws" ] || die "worktree create returned no workspace id"
  [ -n "$tab" ] || die "worktree create returned no root tab id"
  [ -n "$pane" ] || die "worktree create returned no root pane id"

  # Recorded before the agent exists. Every value here is already known, and a
  # spawn that dies further down — no agent could be started, herdr refused a
  # rename — must still leave something `foreman ls` shows and `foreman reap` can
  # remove. Otherwise the failure orphans a worktree no foreman command can see.
  # Tier→model mapping was already validated above; this call only builds the
  # argv plan and the MODEL value recorded beside TIER.
  local agent_args resolved_model=$model arg skills_csv
  agent_args=$(worker_agent_args "$tier" "$model")
  # When the boss passed --tier, record the mapped selector so `meta_get MODEL`
  # answers the same question for both flags.
  if [ -z "$resolved_model" ] && [ -n "$agent_args" ]; then
    resolved_model=$(printf '%s\n' "$agent_args" | sed -n '$p')
  fi
  if [ "$skills_count" -gt 0 ] && [ -n "$command_skill" ]; then
    skills_csv="$command_skill,$(IFS=,; printf '%s' "${skills[*]}")"
  elif [ -n "$command_skill" ]; then
    skills_csv=$command_skill
  elif [ "$skills_count" -gt 0 ]; then
    skills_csv=$(IFS=,; printf '%s' "${skills[*]}")
  else
    skills_csv=""
  fi
  meta_set "$handle" "BOSS=$boss" "BRANCH=$branch" "DIR=$wtpath" "WORKSPACE=$ws" \
    "REPO=$repo" "REPO_KEY=$(repo_key "$repo")" "SKILLS=$skills_csv" "ROLE=$role" \
    "TIER=$tier" "MODEL=$resolved_model"
  : >"$(report_file "$handle")"
  : >"$(report_token_file "$handle")"

  # Forward mapped `--model` tokens as separate argv entries. bash 3.2 has no
  # `${arr[@]}` at a call site without a named array, so rebuild "$@" from the
  # newline-separated plan and hand that to start_worker_agent.
  set --
  while IFS= read -r arg || [ -n "$arg" ]; do
    [ -n "$arg" ] || continue
    set -- "$@" "$arg"
  done <<EOF
$agent_args
EOF
  start_worker_agent "$handle" "$ws" "$pane" "$@"
  # After the agent, deliberately. The agent is the deliverable; the rest of
  # the layout is scenery, and a worker that works beats a tidy dead workspace.
  apply_layout "$layout" "$ws" "$tab" "$pane" "$wtpath"

  printf '%s\n' "$handle"

  if [ "$dispatch" = 1 ] && [ -n "$task" ]; then
    dispatch_to "$handle" "$task$(protocol_block "$handle" "$boss" "$branch" "$wtpath")"
  fi
}

# Put a named, input-ready coding agent in the worktree's own pane.
#
# `worktree create` hands back the workspace's root pane, so there is nothing
# to discover: `agent start` launches the selected harness there, takes the name
# up front, and returns only once herdr has detected it and considers it ready
# for input. That one call replaces a poll for `interactive_ready` followed by
# a rename, and it means foreman no longer needs a layout plugin to start an agent.
#
# `agent start` is a loop because it requires the pane to be *at its interactive
# shell prompt*, and a brand-new worktree pane is not — zsh, mise and direnv
# take a few seconds — so early attempts fail fast and are retried. A configured
# workspace-manager is rejected before worktree creation, so this function
# never participates in a layout race with it.
start_worker_agent() {
  local handle=$1 ws=$2 pane=$3
  shift 3
  # Remaining arguments are forwarded after `--` to the harness (typically
  # `--model <selector>`). Empty means the harness's own default — today's
  # behaviour, and what a spawn without `--tier`/`--model` still does.
  #
  # Branched rather than `"${arr[@]}"`: under bash 3.2 with `set -u`, expanding
  # an empty array is an unbound-variable error, which turned a no-model spawn
  # into a 120s retry storm.
  local has_agent_args=0
  [ $# -gt 0 ] && has_agent_args=1
  # One wall-clock budget for the whole thing. Each attempt is handed what is
  # *left* of it, clamped to herdr's own 300000 cap, so the retry loop cannot
  # multiply the bound by the number of attempts.
  local dl; dl=$(deadline_ms "$SPAWN_TIMEOUT_MS")
  local err="" found="" left

  while :; do
    left=$(remaining_ms "$dl")
    [ "$left" -gt 0 ] || break
    [ "$left" -le 300000 ] || left=300000
    if [ "$has_agent_args" = 1 ]; then
      if err=$(herdr agent start "$handle" --kind omp --pane "$pane" \
                 --timeout "$left" -- "$@" 2>&1); then
        return 0
      fi
    else
      if err=$(herdr agent start "$handle" --kind omp --pane "$pane" \
                 --timeout "$left" 2>&1); then
        return 0
      fi
    fi
    # A failed CLI response can race with the agent it started becoming ready.
    # Recover only if that agent already has the requested handle; a differently
    # named occupant belongs to something else and must never be adopted.
    found=$(workspace_ready_agent "$ws")
    if [ -n "$found" ]; then
      if [ "$(agent_field "$handle" pane_id)" = "$found" ]; then
        note "foreman: the started agent became ready in $found"
        return 0
      fi
      die "workspace $ws already contains an unexpected agent in $found
  foreman will not adopt or rename it
  clean up the worktree with: foreman reap $handle --force"
    fi
    sleep 0.5
  done

  die "could not get an agent into workspace $ws within $((SPAWN_TIMEOUT_MS / 1000))s
  agent start said: $err
  clean up the worktree with: foreman reap $handle --force"
}

# The pane id of an input-ready agent in workspace $1, if there is one.
workspace_ready_agent() {
  h agent list | jq -r --arg w "$1" \
    '[ .result.agents[]?
       | select(.workspace_id == $w and .interactive_ready == true)
       | .pane_id ][0] // empty'
}

# Arrange the worktree's workspace from herdr's own primitives, so that
# removing a layout plugin costs a foreman worktree nothing.
#
# `agent` is the default and is the whole job for a worker: the single pane
# `worktree create` returned, running the selected harness. `full` is for a
# worktree you intend to sit in yourself — editor beside the agent, a shell,
# and a git UI — and is the shape worth pairing with `--no-dispatch`.
#
# Panes and tabs are created unfocused: spawning is something a boss
# does in the background, and it must not yank the view out from under whoever
# is reading something else.
apply_layout() {
  local layout=$1 ws=$2 tab=$3 root=$4 dir=$5
  # Best-effort, in a subshell. The agent is the deliverable and the rest of
  # the layout is scenery: a pane split that fails, a TUI still starting, a
  # shell that has not finished sourcing its rc files — none of that is worth
  # failing a spawn over. Aborting here would skip the dispatch and never even
  # print the handle of the worker that is already up and running.
  if ! ( build_layout "$layout" "$ws" "$tab" "$root" "$dir" ); then
    note "foreman: the '$layout' layout did not finish; the agent pane is up regardless"
  fi
  return 0
}

build_layout() {
  local layout=$1 ws=$2 tab=$3 root=$4 dir=$5
  h tab rename "$tab" agent >/dev/null
  h pane rename "$root" omp >/dev/null
  [ "$layout" = full ] || return 0

  local editor shell review created
  editor=$(h pane split "$root" --direction right --ratio 0.45 --cwd "$dir" \
    --no-focus | jq -r '.result.pane.pane_id // empty')
  [ -n "$editor" ] || die "pane split returned no pane id"
  h pane rename "$editor" editor >/dev/null
  run_pane_command "$editor" "$FOREMAN_EDITOR"

  created=$(h tab create --workspace "$ws" --cwd "$dir" --label shell --no-focus)
  shell=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$shell" ] || die "tab create returned no shell pane id"
  h pane rename "$shell" shell >/dev/null

  created=$(h tab create --workspace "$ws" --cwd "$dir" --label review --no-focus)
  review=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$review" ] || die "tab create returned no review pane id"
  h pane rename "$review" review >/dev/null
  run_pane_command "$review" "$FOREMAN_GIT_UI"
}

# Start a persistent TUI only after the new pane proves its shell can accept
# input. `pane run` is intentionally fire-and-forget; during shell startup it
# can be a successful API call whose input was never consumed.
#
# Retrying nvim/lazygit itself would be unsafe: if the first launch were merely
# slow, the retry would land inside the TUI as keystrokes. Instead retry only a
# harmless printf sentinel. Seeing that exact marker acknowledges the shell;
# the real command is then sent exactly once and only observed. Optional layout
# tools stay optional: if the pane's own shell cannot resolve one, its tab is
# left as a useful shell and spawn says why.
run_pane_command() {
  local pane=$1 command=$2
  local executable=${command%% *}
  executable=$(basename "$executable")
  wait_shell_ready "$pane"
  if ! pane_has_command "$pane" "$executable"; then
    note "foreman: '$executable' is unavailable in $pane; leaving it as a shell"
    return 0
  fi
  h pane run "$pane" "$command" >/dev/null

  local dl; dl=$(deadline_ms "$LAYOUT_START_TIMEOUT_MS")
  while ! expired "$dl"; do
    if pane_runs "$pane" "$executable"; then return 0; fi
    sleep 0.25
  done
  die "'$command' did not start in pane $pane within $((LAYOUT_START_TIMEOUT_MS / 1000))s"
}

pane_has_command() {
  local pane=$1 executable=$2 id=${1//[:]/_} quoted result line
  printf -v quoted '%q' "$executable"
  local available="__foreman_command_available_${id}__"
  local missing="__foreman_command_missing_${id}__"
  # The full marker is not present in this input line: `%s` is filled only
  # during execution. wait-output therefore cannot mistake terminal echo for
  # the command's result.
  h pane run "$pane" \
    "if command -v $quoted >/dev/null 2>&1; then state=available; else state=missing; fi; printf '__foreman_command_%s_${id}__\\n' \"\$state\"" \
    >/dev/null
  result=$(herdr pane wait-output "$pane" \
    --regex "__foreman_command_(available|missing)_${id}__" \
    --source recent-unwrapped --lines 20 --timeout "$LAYOUT_START_TIMEOUT_MS" 2>&1) \
    || die "pane $pane did not answer the command-availability check: $result"
  line=$(printf '%s' "$result" | jq -r '.result.matched_line // empty')
  case "$line" in *"$available"*) return 0 ;; *"$missing"*) return 1 ;;
    *) die "pane $pane returned an invalid command-availability result: $line" ;; esac
}

wait_shell_ready() {
  local pane=$1 id=${1//[:]/_}
  local marker="__foreman_shell_ready_${id}__"
  local dl; dl=$(deadline_ms "$LAYOUT_START_TIMEOUT_MS")
  while ! expired "$dl"; do
    # The full marker is assembled by printf, so terminal echo cannot satisfy
    # the wait. Repetition is harmless; marker output is the acknowledgement.
    h pane run "$pane" "printf '__foreman_shell_%s_${id}__\\n' ready" >/dev/null
    if herdr pane wait-output "$pane" --match "$marker" \
         --source recent-unwrapped --lines 20 --timeout 1000 >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  die "pane $pane did not reach an interactive shell prompt within $((LAYOUT_START_TIMEOUT_MS / 1000))s"
}

pane_runs() {
  herdr pane process-info --pane "$1" 2>/dev/null \
    | jq -e --arg executable "$2" '
        any(.result.process_info.foreground_processes[]?;
            .name == $executable
            or ((.argv0 // "") | split("/")[-1] == $executable))' \
      >/dev/null
}

# ── Dispatch ─────────────────────────────────────────────────────────────────

# Whether the report on disk answers the most recent dispatch, matched by
# dispatch counter rather than mtime.
#
# A worker with no dispatch on record — spawned `--no-dispatch`, then prompted
# by hand — has neither file, and an empty token matching an empty counter is
# the right answer: whatever it wrote is all there is.
report_is_fresh() {
  local handle=$1 want="" got="" f
  [ -s "$(report_file "$handle")" ] || return 1
  f=$(dispatch_file "$handle"); if [ -f "$f" ]; then want=$(cat "$f"); fi
  f=$(report_token_file "$handle"); if [ -f "$f" ]; then got=$(cat "$f"); fi
  [ "$want" = "$got" ]
}

# Submit, then confirm the agent actually picked it up. herdr only fails a
# stalled prompt under `agent prompt --wait`, and that waits for a *settled*
# state — the opposite of what is wanted here. "Accepted" is not "started":
# without this loop a following `foreman join` can match the agent's
# pre-dispatch idle state and return instantly.
#
# The evidence is `state_change_seq`, not the status alone. A status of
# `working` read straight after submission may be the turn that was already
# running. Failing closed is the point — a dispatch that reports success on a
# prompt that never ran is worse than one that dies, and the worktree and meta
# already exist by then, so `foreman read` and `foreman reap` still work on it.
#
# The one exception is a worker's *first* dispatch, which is `foreman spawn`'s
# own call. See the working|blocked branch below.
dispatch_to() {
  local handle=$1 text=$2
  local before_status before_seq prior pane
  before_status=$(agent_field "$handle" agent_status)
  before_seq=$(agent_field "$handle" state_change_seq)
  # Which pane to ring, if this worker's session has a sidecar. Looked up per
  # dispatch rather than recorded once, for the same reason bus_sidecar_file is
  # keyed by pane: a handle can move between panes mid-wave.
  pane=$(agent_field "$handle" pane_id)
  # Whether this worker has ever been dispatched to. The identity hazard below
  # needs an *earlier* report to steal the label of, so an empty counter means
  # there is nothing to protect.
  prior=$(counter_read "$(dispatch_file "$handle")")

  case "$before_status" in
    working|blocked)
      if [ -n "$prior" ]; then
        # There is no herdr turn id to stamp into a report. If dispatch 2 is
        # queued while dispatch 1 is running, dispatch 1's eventual `foreman
        # report` reads the now-current counter and labels itself as dispatch
        # 2. Refusing is the only way to preserve report identity. Raw steering
        # is deliberately untracked, so answers and approval input remain
        # allowed.
        die "$handle is $before_status and cannot accept a new tracked task yet
  steer its current turn:  foreman send --raw $handle \"<answer>\"
  or collect it first:     foreman join $handle"
      fi
      # A first dispatch is the `foreman spawn` path, and a freshly started omp
      # can legitimately be initializing or sitting on a first-run trust
      # prompt. Refusing here would fail a spawn *after* its worktree, agent
      # and layout exist, which is worse than the stale-label risk this guard
      # exists for — and that risk is zero with no prior dispatch. The settle
      # check is skipped rather than failed: a dialog may absorb the text
      # without ever producing a lifecycle transition to observe.
      mkdir -p "$(meta_dir "$handle")"
      # Written before the counter bump, always — see the ordering note on
      # the normal branch below for why the other order is unsafe.
      printf '%s' "$text" >"$(task_file "$handle")"
      counter_bump "$(dispatch_file "$handle")"
      if bus_signal "$pane"; then
        note "foreman: $handle was $before_status at its first dispatch; queued for bus pickup instead of a prompt (check it with: foreman read $handle)"
      else
        h agent prompt "$handle" "$text" >/dev/null
        # This path delivered the text itself, so the generation is already
        # consumed. Leaving it unacked would let a listener that arms later —
        # the moment the omp plugin is installed — replay it as a fresh aside.
        counter_ack "$(dispatch_file "$handle")" "$(task_token_file "$handle")"
        note "foreman: $handle was $before_status at its first dispatch; submitted without confirming pickup (check it with: foreman read $handle)"
      fi
      return 0
      ;;
  esac

  mkdir -p "$(meta_dir "$handle")"
  # task.md before the counter bump, deliberately: a wake fired on a bumped
  # `dispatched` with no task.md written yet would tell `foreman pickup` a
  # task is ready and hand it an empty (or stale, pre-this-dispatch) file.
  printf '%s' "$text" >"$(task_file "$handle")"
  counter_bump "$(dispatch_file "$handle")"
  # A delivered wake already owns delivery: prompting on top of it would inject
  # the task twice, once as a herdr prompt and once as the aside `foreman
  # pickup` produces off the wake.
  if ! bus_signal "$pane"; then
    h agent prompt "$handle" "$text" >/dev/null
    # As on the first-dispatch branch: the prompt consumed this generation, so
    # ack it rather than leaving a task for a later listener to replay.
    counter_ack "$(dispatch_file "$handle")" "$(task_token_file "$handle")"
  fi

  local dl status="" seq=""
  dl=$(deadline_ms "$DISPATCH_SETTLE_MS")
  while ! expired "$dl"; do
    status=$(agent_field "$handle" agent_status)
    seq=$(agent_field "$handle" state_change_seq)
    case "$status" in
      # `state_change_seq` sharpens this check; it does not gate it. herdr
      # 0.8.0 reports it on every agent, but a build that does not would leave
      # both values blank — and failing closed on that would turn every
      # dispatch into a DISPATCH_SETTLE_MS death. Blank degrades to the
      # status-only check this replaced.
      working|blocked)
        if [ -z "$before_seq" ] || [ "$seq" != "$before_seq" ]; then return 0; fi
        ;;
      # A task small enough to finish inside the settle window still counts,
      # but only on the evidence of a report answering *this* dispatch.
      idle|done) if report_is_fresh "$handle"; then return 0; fi ;;
    esac
    sleep 0.5
  done
  die "$handle did not pick up the prompt within $((DISPATCH_SETTLE_MS / 1000))s (status: ${status:-gone})
  inspect it with: foreman read $handle"
}

with_protocol() {
  local handle=$1 text=$2
  printf '%s%s' "$text" \
    "$(protocol_block "$handle" "$(meta_get "$handle" BOSS)" \
       "$(meta_get "$handle" BRANCH)" "$(meta_get "$handle" DIR)")"
}

# The rest of the command line, or stdin. Reading stdin silently at a terminal
# just looks like a hang, so a tty with no argument is a usage error instead.
read_message() {
  local what=$1; shift
  local text="$*"
  if [ -z "$text" ]; then
    if [ -t 0 ]; then
      die "usage: foreman $what   (or pipe the text on stdin)"
    fi
    text=$(cat)
  fi
  [ -n "$text" ] || die "nothing to send"
  printf '%s' "$text"
}
# Raw text is steering, not a new tracked task. In particular, answering a
# worker's question must not bump the dispatch counter and make the eventual
# report for the original task look stale. It also cannot wait for a lifecycle
# transition: a keystroke into an approval UI may leave the agent `blocked`,
# and an answer queued behind a working turn has no transition of its own yet.
prompt_raw() {
  local handle=$1 text=$2 status
  status=$(agent_field "$handle" agent_status)
  h agent prompt "$handle" "$text" >/dev/null
  [ "$status" != working ] \
    || note "foreman: $handle was already working; the raw message is queued behind its current turn"
}

cmd_send() {
  require_herdr
  local raw=0
  while [ $# -gt 0 ]; do
    case $1 in
      --raw) raw=1; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  local handle=${1:?usage: foreman send [--raw] <handle> <text...>}; shift
  case "${1:-}" in --raw) raw=1; shift ;; esac
  agent_exists "$handle" || die "no live agent named '$handle'"
  local text; text=$(read_message "send [--raw] <handle> <text...>" "$@")
  if [ "$raw" != 1 ] && [ ! -f "$(meta_file "$handle")" ]; then
    die "'$handle' is live but not a registered foreman worker; a tracked task would send it a broken protocol block and mint a phantom record
  steer it instead: foreman send --raw $handle \"<text>\""
  fi
  if [ "$raw" = 1 ]; then
    # No protocol block. A one-line answer does not want the contract
    # restated, and re-appending "do not open a PR unless the task above says
    # to" over an answer makes *that answer* "the task above" — which is how a
    # worker talks itself out of the PR its original brief asked for. It is
    # also the only way to put a bare keystroke into a blocked approval.
    prompt_raw "$handle" "$text"
  else
    dispatch_to "$handle" "$(with_protocol "$handle" "$text")"
  fi
  # Anything the boss sends a worker settles whatever that worker was waiting
  # on: a raw send is the answer itself, and a tracked task supersedes the
  # question outright. Guarded on the meta file so a raw steer to some
  # non-foreman agent cannot mint a phantom state directory.
  if [ -f "$(meta_file "$handle")" ]; then mark_question_answered "$handle"; fi
}

cmd_ask() {
  require_herdr
  local timeout=""
  if [ "${1:-}" = --timeout ]; then
    timeout=${2:?usage: foreman ask [--timeout <seconds>] <handle> <text...>}
    shift 2
  fi
  # Rejected in both positions cmd_send would honor it — before the handle and
  # immediately after it. A raw send has no pickup confirmation, so the join
  # that follows would match the agent's pre-dispatch idle state and return a
  # stale report: the exact race dispatch_to's settle check exists to prevent.
  local raw_refused="foreman ask dispatches a tracked task and waits for its report; --raw steering files no report to wait for
  send it instead:  foreman send --raw <handle> \"<text>\"
  then if needed:   foreman join <handle>"
  local a handle="" after_handle=0
  for a in "$@"; do
    if [ "$after_handle" = 1 ]; then
      case "$a" in --raw) die "$raw_refused" ;; esac
      break
    fi
    case "$a" in
      --raw) die "$raw_refused" ;;
      --) continue ;;
      *) handle=$a; after_handle=1 ;;
    esac
  done
  [ -n "$handle" ] || die "usage: foreman ask [--timeout <seconds>] <handle> <text...>"
  cmd_send "$@"
  if [ -n "$timeout" ]; then cmd_join --timeout "$timeout" "$handle"; else cmd_join "$handle"; fi
}

# ── Peer messaging ───────────────────────────────────────────────────────────
#
# broadcast, dm, and keys are steering, not dispatch: they must never touch
# the dispatch counter dispatch_to guards above. A reply to the current turn
# must not be mistaken for a new tracked task, and a keystroke into a working
# agent has no report to be fresh against.

cmd_broadcast() {
  require_herdr
  local me; me=$(self_handle)
  [ -n "$me" ] || die "this pane has no herdr agent name; run 'foreman boss' first"
  local text; text=$(read_message "broadcast <text...>" "$@")
  local scope; scope=$(scoped_key "foreman broadcast" "run it from inside a repo")
  # One `agent list` for the whole wave, not one per worker — the same
  # round-trip rationale as cmd_join's per-tick snapshot.
  local agents handle sent=0
  agents=$(h agent list)
  for handle in $(known_workers "$scope"); do
    [ "$handle" != "$me" ] || continue
    if [ -n "$(snapshot_status "$agents" "$handle")" ]; then
      prompt_raw "$handle" "[foreman broadcast from $me] $text"
      printf 'sent: %s\n' "$handle"
      sent=$((sent + 1))
    else
      printf 'skipped (not live): %s\n' "$handle"
    fi
  done
  [ "$sent" -gt 0 ] || die "no live workers in this repo"
}

# Whether $1 is currently recognized as a boss: either the handle a
# boss would claim by default, or some worker's own record names it as BOSS —
# which covers a renamed/--steal'd boss, since rebind_boss keeps that in sync.
is_boss_handle() {
  local handle=$1 w
  [ "$handle" = "$(default_boss)" ] && return 0
  for w in $(known_workers); do
    [ "$(meta_get "$w" BOSS)" = "$handle" ] && return 0
  done
  return 1
}

cmd_dm() {
  require_herdr
  local me; me=$(self_handle)
  [ -n "$me" ] || die "this pane has no herdr agent name; join the foreman first"
  local handle=${1:?usage: foreman dm <handle> <text...>}; shift
  valid_handle "$handle" || die "invalid handle '$handle'"
  agent_exists "$handle" || die "no live agent named '$handle'"
  if [ ! -f "$(meta_file "$handle")" ] && ! is_boss_handle "$handle"; then
    die "'$handle' is live but not a foreman member (see: foreman ls)"
  fi
  local text; text=$(read_message "dm <handle> <text...>" "$@")
  prompt_raw "$handle" "[foreman dm from $me] $text"
}

cmd_keys() {
  require_herdr
  local handle=${1:?usage: foreman keys <handle> <key>...}; shift
  valid_handle "$handle" || die "invalid handle '$handle'"
  agent_exists "$handle" || die "no live agent named '$handle'"
  [ $# -gt 0 ] || die "usage: foreman keys <handle> <key>..."
  # herdr stays the authority on key names (same philosophy as the removed
  # kind validation): a bad key is herdr's error to report, not foreman's to
  # pre-judge.
  h agent send-keys "$handle" "$@" >/dev/null
}

# Everything join prints for one worker.
print_result() {
  local handle=$1 status=$2 rf; rf=$(report_file "$handle")
  printf '\n=== %s (%s) — branch %s\n' "$handle" "$status" "$(meta_get "$handle" BRANCH)"
  if report_is_fresh "$handle"; then
    cat "$rf"
  elif [ "$status" = gone ]; then
    printf '(the agent is no longer live and filed no report since its last dispatch)\n'
    if [ -s "$rf" ]; then printf '(previous report follows)\n'; cat "$rf"; fi
    printf '(recorded worktree path: %s)\n' "$(meta_get "$handle" DIR)"
  elif [ "$status" = blocked ]; then
    printf '(blocked, nothing reported since the last dispatch — last output below)\n'
    herdr agent read "$handle" --source recent-unwrapped --lines 40 2>/dev/null \
      || printf '(could not read the pane; the agent may have just exited)\n'
    printf '\nunblock it:       foreman send --raw %s "<answer or keystroke>"\nthen collect it:  foreman join %s\n' "$handle" "$handle"
  elif [ -s "$rf" ]; then
    # Stale, but kept: a follow-up `foreman send` must not destroy the report a
    # worker already filed, so staleness is dated rather than deleted.
    printf '(nothing reported since the last dispatch; previous report follows)\n'
    cat "$rf"
  else
    printf '(no report written; check with: foreman read %s)\n' "$handle"
  fi
}

# A worker's `foreman reply` bumps question.seq. Two acknowledgements are then
# tracked separately because two readers need different facts: a sweep asks
# "does the boss have this text yet" (seen), while a blocking join asks "is
# this worker still stuck on me" (answered). Collapsing them into one counter
# either re-asks, every tick, a question the worker already pushed, or lets a
# `foreman ask` sit out its full hour waiting for a report that is never coming
# because the worker is waiting on an answer.
question_undelivered() {
  [ "$(counter_read "$(question_seq_file "$1")")" \
    != "$(counter_read "$(question_seen_file "$1")")" ]
}

question_open() {
  [ "$(counter_read "$(question_seq_file "$1")")" \
    != "$(counter_read "$(question_answered_file "$1")")" ]
}

mark_question_seen() {
  counter_ack "$(question_seq_file "$1")" "$(question_seen_file "$1")"
}

# Answering marks the text delivered too: a boss cannot answer a question it
# never received, and leaving `seen` behind would make the next join reprint a
# question that is already settled.
mark_question_answered() {
  mark_question_seen "$1"
  counter_ack "$(question_seq_file "$1")" "$(question_answered_file "$1")"
}

print_question() {
  local handle=$1 qf; qf=$(question_file "$handle")
  printf '\n=== %s — QUESTION — branch %s\n' "$handle" "$(meta_get "$handle" BRANCH)"
  # Always the body, never a "you already got this" placeholder. `seen` records
  # that pickup handed the text to omp, not that the boss ever read it: omp
  # holds the followUp behind the boss's current turn, so a boss mid-turn was
  # told "already delivered" for a question still sitting in that queue. One
  # shipped run reaped the worker on the strength of that placeholder and then
  # received the real question 13ms after the turn ended.
  #
  # Nothing is lost by dropping the "asked over and over" guard that used to
  # live here, because it never guarded anything: cmd_join (:2110) reaches this
  # for an *already delivered* question only when `once` is 0, and a sweep —
  # pickup included — is always `--once`. The blocking arm runs because a boss
  # asked, which is precisely when withholding the text is wrong.
  if [ -s "$qf" ]; then cat "$qf"; fi
  # No "then re-run: foreman join": the answer resumes the worker, and the
  # report it files next arrives on its own.
  printf '\nanswer it with: foreman send --raw %s "<answer>"\n' "$handle"
  mark_question_seen "$handle"
}

mark_joined() {
  counter_ack "$(dispatch_file "$1")" "$(joined_token_file "$1")"
}

pending_confirm_file() { printf '%s/pending_confirm' "$(meta_dir "$1")"; }

# `idle`/`done` with no fresh report is ambiguous, not necessarily final: an
# agent's status flips to idle the moment its turn ends, but that signal
# comes from herdr's own process/pane tracking, independent of and with no
# ordering guarantee against a *different* process's view of the report file
# `foreman_report` just wrote in that same turn. A poller ticking every few
# seconds right after dispatch (unlike a human who naturally calls `join`
# well after spawn) is exactly what makes this race observable in practice:
# it can catch "idle" a beat before the report is visible, and — because
# `mark_joined` fires unconditionally once a status settles — that report is
# then lost forever, silently, since the bumped joined counter makes the
# worker un-joinable again even after the real report lands moments later.
#
# Fix: require the SAME sighting (same dispatch generation) twice before
# treating an unfresh idle/done as final. A worker that is genuinely done
# with nothing to report is still idle with nothing to report on the next
# tick, so this costs at most one `JOIN_POLL_MS` of latency; a worker mid-race
# resolves on the very next check once its report becomes visible.
settled_confirmed() {
  local handle=$1 cf current
  cf=$(pending_confirm_file "$handle")
  current=$(counter_read "$(dispatch_file "$handle")")
  if [ -n "$current" ] && [ "$(counter_read "$cf")" = "$current" ]; then
    rm -f "$cf"
    return 0
  fi
  mkdir -p "$(meta_dir "$handle")"
  printf '%s' "$current" >"$cf"
  return 1
}

# Registered workers holding something the boss has not been handed yet: an
# undelivered question, or a dispatch whose result has not been collected.
# Strictly *undelivered*, never merely unanswered — a worker waiting on an
# answer stays waiting for as long as the boss takes, and keying this on that
# would make every sweep tick re-serve the same question forever.
#
# Deliberately `known`, not `live`: a worker can die after dispatch and before
# join, and silently filtering it out is the same lost-result bug as aborting
# on agent_not_found.
joinable_workers() {
  local handle
  for handle in $(known_workers "${1-}"); do
    if question_undelivered "$handle"; then printf '%s\n' "$handle"; continue; fi
    if [ "$(counter_read "$(dispatch_file "$handle")")" \
       = "$(counter_read "$(joined_token_file "$handle")")" ]; then continue; fi
    printf '%s\n' "$handle"
  done
  true
}

snapshot_status() {
  printf '%s' "$1" | jq -r --arg n "$2" \
    '(.result.agents[]? | select(.name == $n) | .agent_status) // empty'
}


# Collect results. Three properties the old sequential `agent wait` loop did
# not have:
#
#  - Fault tolerance. `herdr agent wait` errors with agent_not_found for a
#    worker whose pane was closed, and `h` turns that into a fatal — so one
#    dead worker discarded the reports of every worker already settled and
#    every worker after it in the list.
#  - Order independence. Waiting handle by handle hid a worker that finished
#    first behind one that finishes last. Polling the whole set prints each
#    result the moment it lands.
#  - Termination. Nothing makes a worker call `foreman report`; an omp that ends
#    its turn is simply idle, which settles instantly — so the documented
#    "join again until everyone reports" spun. A settle is now recorded
#    against the dispatch counter it answers, and a bare `join` skips workers
#    already collected at their current counter. A `foreman send` bumps that
#    counter and makes the worker joinable again, which is precisely when
#    re-joining means something.
#
# And it returns early on a filed question, which is what actually lets a
# blocked worker preempt the wave. For a named handle that early return covers
# an already-delivered question too: the pushed copy reached the boss's pane,
# but not a boss that is *inside* this call, so without it `foreman ask` would
# sit out its entire timeout waiting for a report from a worker that is itself
# waiting on the caller.
#
# `--once` runs exactly that inner tick — no deadline, no `sleep_ms` — and
# returns whatever settled (possibly nothing). It exists so something outside
# this process can sweep cheaply on its own schedule: the omp foreman extension
# runs it from a session-owned timer. Since `foreman report` and `foreman reply`
# push straight to the boss's pane, that sweep is no longer the delivery path —
# it is the net under what a push cannot cover: a worker that ended its turn
# without reporting, one that died, and a push that had no live boss to land
# on. It exits 3 when there is nothing registered to sweep at all, so a poller
# can park its timer instead of spawning a subprocess every few seconds for a
# repo whose workers are all collected.
cmd_join() {
  require_herdr
  # Built as a string, not an array: bash 3.2 (what ships on macOS) treats
  # ${#arr[@]} on an empty array as an unbound-variable error under `set -u`,
  # and handles are whitespace-free by construction.
  local timeout_ms=$WAIT_TIMEOUT_MS handle handles="" scope once=0

  while [ $# -gt 0 ]; do
    case $1 in
      --timeout)
        case "${2-}" in
          ''|*[!0-9]*) die "usage: foreman join [--timeout <seconds>] [--once] [handle...]" ;;
        esac
        timeout_ms=$(($2 * 1000))
        shift 2
        ;;
      --once)
        once=1
        shift
        ;;
      --*)
        die "usage: foreman join [--timeout <seconds>] [--once] [handle...]"
        ;;
      *)
        handles="$handles $1"
        shift
        ;;
    esac
  done
  handles=${handles# }

  # Validated before anything prints, like cmd_reap, so one typo cannot abort a
  # wave that already printed results.
  if [ -n "$handles" ]; then
    for handle in $handles; do
      valid_handle "$handle" || die "invalid handle '$handle'"
      [ -d "$(meta_dir "$handle")" ] || die "no foreman record for '$handle' (see: foreman ls)"
    done
  fi

  if [ -z "$handles" ]; then
    # A worker's own scope is its siblings, not the workers it spawned:
    # repo_key() (see :202) deliberately groups a worktree with the repo it
    # came from, so joinable_workers() scoped by REPO_KEY here would collect
    # whatever its siblings left un-joined — reports that belong to the real
    # boss, not this pane. `--once` gets no exemption: it is what the omp
    # extension's poller runs unattended, and a poller mistakenly armed
    # inside a worker session would otherwise silently steal from its
    # siblings on every tick until its own 5-consecutive-failure backoff (see
    # extension/index.ts) shuts it down having collected nothing.
    local me; me=$(self_handle)
    if [ -n "$me" ] && [ -f "$(meta_file "$me")" ]; then
      die "'$me' is a registered foreman worker; a bare 'foreman join' here
  would collect its siblings' reports, not any it spawned itself —
  repo_key() scopes by the repo, not by boss. Name the handles you
  actually want: foreman join <handle...>"
    fi
    scope=$(scoped_key "foreman join" "run it from inside a repo, or name the handles to join")
    handles=$(joinable_workers "$scope")
    if [ -z "${handles// /}" ]; then
      # A sweep hits this constantly while a wave is quiet; noting it every
      # tick would drown real output. Exit 3 is distinct from both "collected
      # something" and "failed", which is what lets a poller tell "nothing is
      # registered here" from "nothing has settled yet" and stop ticking.
      if [ "$once" = 1 ]; then return 3; fi
      note "foreman: nothing to join — every worker in this repo has been collected since its last dispatch (see: foreman ls)"
      return 0
    fi
  fi
  [ -n "${handles// /}" ] || die "no workers to join"

  local dl pending="$handles" remaining status agents
  dl=$(deadline_ms "$timeout_ms")
  while :; do
    # One `agent list` per tick rather than one per worker per tick: a wave of
    # five would otherwise be 150 herdr round-trips a minute for nothing.
    agents=$(h agent list)
    remaining=""
    for handle in $pending; do
      # Two different readers of one question. A blocking join must return the
      # moment a worker is waiting on the boss — whether or not the question
      # already reached it — because continuing to wait for a report that
      # cannot come is the deadlock `foreman ask` used to sit in for an hour.
      # A sweep tick must only carry a question the boss has *not* seen, or it
      # would re-serve the same one every tick for as long as it went
      # unanswered.
      if question_undelivered "$handle" \
         || { [ "$once" = 0 ] && question_open "$handle"; }; then
        print_question "$handle"
        [ "$once" = 1 ] || note "foreman: '$handle' is waiting on you; join returned early"
        return 0
      fi
      status=$(snapshot_status "$agents" "$handle")

      case "$status" in
        '') print_result "$handle" gone; mark_joined "$handle" ;;
        blocked)
          print_result "$handle" "$status"
          mark_joined "$handle"
          ;;
        idle|done)
          # An unanswered question means the worker is parked on the boss, not
          # finished. Settling it here would hand the boss "(no report
          # written)" for work that has not stopped, and stamp `joined` so the
          # real report never sweeps. A fresh report still wins: a worker may
          # report anyway after asking, and if its own push failed this loop
          # is the only thing left to carry it.
          if report_is_fresh "$handle" \
             || { ! question_open "$handle" && settled_confirmed "$handle"; }; then
            print_result "$handle" "$status"
            mark_joined "$handle"
          else
            remaining="$remaining $handle"
          fi
          ;;
        *) remaining="$remaining $handle" ;;
      esac
    done
    pending=$remaining
    [ -n "${pending// /}" ] || return 0
    if [ "$once" = 1 ]; then return 0; fi
    if expired "$dl"; then
      note "foreman: gave up after $((timeout_ms / 1000))s; still working:$pending"
      return 1
    fi
    sleep_ms "$JOIN_POLL_MS"
  done
}

cmd_read() {
  require_herdr
  local handle=${1:?usage: foreman read <handle> [-n lines]}; shift
  local lines=120
  [ "${1:-}" = "-n" ] && { lines=${2:?}; shift 2; }
  h agent read "$handle" --source recent-unwrapped --lines "$lines"
}

# ── Worker side ──────────────────────────────────────────────────────────────

cmd_report() {
  require_herdr
  local me; me=$(self_handle)
  [ -n "$me" ] || die "this pane is not a named foreman worker"
  # A registered worker always has a meta file, written by `foreman spawn` before
  # its agent existed. Without this check `foreman report` in a boss's
  # own pane silently creates a state directory named after the boss,
  # which then shows up as a phantom worker in `foreman ls --all-repos`.
  [ -f "$(meta_file "$me")" ] \
    || die "'$me' is not a registered foreman worker; 'foreman report' is a worker command"
  local rf; rf=$(report_file "$me")
  if [ "${1:-}" = "-f" ]; then
    cp "${2:?usage: foreman report -f <file>}" "$rf"
  elif [ $# -gt 0 ]; then
    printf '%s\n' "$*" >"$rf"
  else
    cat >"$rf"
  fi
  # Stamp the report with the dispatch it answers, so the boss can tell
  # a fresh report from the one this worker filed before its last instruction.
  counter_ack "$(dispatch_file "$me")" "$(report_token_file "$me")"

  local bytes boss; bytes=$(wc -c <"$rf" | tr -d ' '); boss=$(boss_handle)
  # Delivery belongs to the protocol, not to whatever the boss's harness
  # happens to poll. A report nobody is told about is one the boss finds only
  # if it thinks to run `foreman join` — which is why collecting a wave used to
  # mean blocking a tool call on it.
  local rc=0
  notify_agent "$boss" "$(printf '[foreman:%s] report — branch %s\n\n%s' \
    "$me" "$(meta_get "$me" BRANCH)" "$(cat "$rf")")" || rc=$?
  case $rc in
    0)
      # The prompt put the text in the boss's session, so a bare `foreman join`
      # must not hand it the same report a second time. A named `foreman join
      # <handle>` still re-prints on demand: it bypasses the joinable filter.
      mark_joined "$me"
      printf 'reported %s bytes to %s\n' "$bytes" "$boss"
      ;;
    2)
      # A doorbell moved no text. `foreman pickup` on the boss's side is what
      # delivers it, and marks it joined once it has — stamping here instead
      # made pickup skip the report as already collected, so it arrived
      # nowhere and the worker still reported success.
      printf 'reported %s bytes to %s\n' "$bytes" "$boss"
      ;;
    *)
      note "foreman: boss '$boss' is not reachable; the report is filed and will surface on its next 'foreman join'"
      printf 'reported %s bytes (filed for %s)\n' "$bytes" "$boss"
      ;;
  esac
}

cmd_reply() {
  require_herdr
  local me; me=$(self_handle)
  [ -n "$me" ] || die "this pane is not a named foreman worker"
  [ -f "$(meta_file "$me")" ] \
    || die "'$me' is not a registered foreman worker; 'foreman reply' is a worker command"
  local boss; boss=$(boss_handle)
  local text; text=$(read_message "reply <text...>" "$@")

  # Filed first, delivered second. The file is not a redundant copy of the
  # push: herdr's prompt only reaches a boss that is between tool calls, and
  # one sitting inside `foreman join` does not read its input until that call
  # returns — an hour away by default — so the file is what lets a blocked
  # worker preempt a wave the boss is already blocked on.
  # A second question filed before the first is answered must not destroy the
  # first, which is why this keys on unanswered rather than undelivered: the
  # push stamps the first one delivered immediately.
  local qf; qf=$(question_file "$me")
  if question_open "$me" && [ -s "$qf" ]; then
    printf -- '\n---\n%s\n' "$text" >>"$qf"
  else
    printf '%s\n' "$text" >"$qf"
  fi
  counter_bump "$(question_seq_file "$me")"

  # The answer command rides along with the question: this lands in the boss's
  # pane, where nothing else is going to tell it how to reply.
  local rc=0
  notify_agent "$boss" "$(printf '[foreman:%s] question — branch %s\n\n%s\n\nanswer it with: foreman send --raw %s "<answer>"' \
    "$me" "$(meta_get "$me" BRANCH)" "$text" "$me")" || rc=$?
  case $rc in
    0)
      # The prompt delivered it, so a sweep must not ask it again on its next
      # tick. Skipping this stamp is what made every question arrive twice.
      mark_question_seen "$me"
      printf 'asked %s\n' "$boss"
      ;;
    2)
      # Doorbell only: `foreman pickup` still has to read the question off disk
      # and stamps it seen once it has. Stamping here left the boss with a
      # question it was never handed — the same silent loss as a report.
      printf 'asked %s\n' "$boss"
      ;;
    *)
      # Not fatal: the question is on disk, so a boss that comes
      # back — or a different one — still collects it.
      note "foreman: boss '$boss' is not live; the question is filed and will surface on the next 'foreman join'"
      ;;
  esac
}

# ── Bus (MCP notification sidecar) ──────────────────────────────────────────
#
# `foreman bus` is a long-lived stdio JSON-RPC process omp spawns as an MCP
# server; `foreman pickup` is the one-shot pull it wakes the extension into
# running. The bus carries no payload — see the module header — so pickup is
# the only thing that ever decides what an agent actually receives, and it is
# safe to run on any tick (a timer, a wake, or by hand) with no double
# delivery, which is what lets the interval sweep and the wake share it.

# Pulled by the omp extension after `notifications/foreman/wake`, and on its
# own slow timer as an anomaly net for a wake that never fired (e.g. a bus
# that died mid-tick). Exit 0 with stdout to inject, exit 3 with nothing to
# mean "nothing to deliver right now", anything else an error.
cmd_pickup() {
  local handle; handle=$(self_handle) || return 1
  [ -n "$handle" ] || return 1

  # A tracked task first, ahead of the join sweep below: the sweep only ever
  # collects *other* handles' reports and questions (see cmd_join's own-pane
  # guard), so a task dispatched straight to this pane would otherwise never
  # surface through pickup at all.
  local tf tsf dispatched_n seen_n
  tf=$(task_file "$handle")
  tsf=$(task_token_file "$handle")
  if [ -s "$tf" ]; then
    dispatched_n=$(counter_read "$(dispatch_file "$handle")")
    seen_n=$(counter_read "$tsf")
    # String comparison, like every other counter here: "never dispatched"
    # and "dispatched zero times" must read as equal so a task.md left over
    # from before task.seen existed is not replayed as new.
    if [ "$dispatched_n" != "$seen_n" ]; then
      cat "$tf"
      counter_ack "$(dispatch_file "$handle")" "$tsf"
      return 0
    fi
  fi

  # A registered worker has nothing further to collect, so stop here rather
  # than falling into the join below: it refuses on a worker pane by design
  # (:2012) and that refusal would surface as a pickup *error*, which the
  # extension counts toward the five consecutive failures that park its
  # sweeper for the rest of the session.
  if [ -f "$(meta_file "$handle")" ]; then return 3; fi

  # Falls through to exactly the tick `foreman join --once` already runs — same
  # report and question formatting, same acking — so a boss's pickup can never
  # drift from what a human running `foreman join` sees. `--once` is also what
  # keeps a timer tick from re-serving a question the boss already has: see
  # cmd_join's own condition (:2110).
  local out rc=0
  out=$(cmd_join --once) || rc=$?
  [ "$rc" = 3 ] && return 3
  [ "$rc" = 0 ] || return "$rc"
  [ -n "$out" ] || return 3
  printf '%s\n' "$out"
  return 0
}

# Both the read loop and the USR1 trap write this inherited stdout. A frame is
# well below PIPE_BUF and this one printf writes its one newline-delimited line
# atomically; bash also runs a trap only between commands, so a wake can never
# tear the JSON framing of a reply mid-write.
bus_emit() { printf '%s\n' "$1"; }

bus_reply_initialize() {
  local frame
  frame=$(jq -cn --arg id "$1" --arg pv 2025-11-25 --arg v "$(foreman_version)" '
    {jsonrpc:"2.0", id:($id|tonumber? // $id), result:{
      protocolVersion:$pv,
      capabilities:{tools:{}},
      serverInfo:{name:"foreman", version:$v}}}')
  bus_emit "$frame"
}

# Zero tools rejects the alternative of exposing the doorbell as a model
# surface: the bus must contribute nothing to context and carry no work.
bus_reply_tools_list() {
  local frame
  frame=$(jq -cn --arg id "$1" '{jsonrpc:"2.0", id:($id|tonumber? // $id), result:{tools:[]}}')
  bus_emit "$frame"
}

bus_reply_empty() {
  local frame
  frame=$(jq -cn --arg id "$1" '{jsonrpc:"2.0", id:($id|tonumber? // $id), result:{}}')
  bus_emit "$frame"
}

bus_reply_no_method() {
  local frame
  frame=$(jq -cn --arg id "$1" --arg m "$2" '
    {jsonrpc:"2.0", id:($id|tonumber? // $id),
     error:{code:-32601, message:("Method not found: " + $m)}}')
  bus_emit "$frame"
}

# A constant frame, so no jq: this runs from a signal handler, where forking a
# subprocess to produce a fixed string is both waste and one more thing that
# can fail while a report is waiting on it.
bus_notify_wake() { bus_emit '{"jsonrpc":"2.0","method":"notifications/foreman/wake"}'; }

# One JSON-RPC frame in, zero or one out. A notification (no id) gets no
# reply even when unknown — replying would desync a client that never
# expects one for it — while an unknown *request* still gets -32601 so a
# well-behaved client does not hang waiting on a response that never comes.
bus_handle_frame() {
  local line=$1 method id
  method=$(printf '%s' "$line" | jq -r '.method // empty' 2>/dev/null) || return 0
  id=$(printf '%s' "$line" | jq -r 'if has("id") then (.id|tostring) else "" end' 2>/dev/null) || return 0
  case "$method" in
    initialize)                 bus_reply_initialize "$id" ;;
    notifications/initialized)  : ;;
    tools/list)                 bus_reply_tools_list "$id" ;;
    ping)                       bus_reply_empty "$id" ;;
    roots/list)                 bus_reply_empty "$id" ;;
    "")                         : ;;
    *) [ -n "$id" ] && bus_reply_no_method "$id" "$method" ;;
  esac
  # An unknown *notification* (empty id) falls through the case with the
  # `[ -n "$id" ]` guard false, which would make this function's own return
  # status 1 and — called as a bare `&&`-list statement, not an if/while
  # condition — trip `set -e` and kill the whole sidecar over a frame it was
  # correctly ignoring.
  return 0
}

# Records this sidecar so a worker can find its pane, and prunes the corpses of
# sidecars that were SIGKILLed before their EXIT trap ran. Pruning lives here
# because this runs exactly once per session, which makes it the cheapest place
# for it; one file per omp session would otherwise accumulate forever.
#
# A pane-less session (plain omp outside herdr) publishes nothing and is
# unreachable by a wake, which is correct rather than an error: no worker can
# name it as a boss in the first place.
bus_publish() {
  local f dir g pid
  [ -n "${HERDR_PANE_ID:-}" ] || return 0
  f=$(bus_sidecar_file "$HERDR_PANE_ID")
  dir=$(dirname "$f")
  mkdir -p "$dir" || return 0
  for g in "$dir"/*; do
    [ -f "$g" ] || continue
    pid=""
    IFS= read -r pid <"$g" || :
    # An explicit `if`, not `A && B || C`: the latter reads as if-then-else but
    # also runs C when A succeeds and B fails, which is the same thing here by
    # luck rather than by construction.
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then rm -f "$g"; fi
  done
  # `$$` is this sidecar; `$PPID` is the omp session that spawned it as its
  # stdio MCP server. Both, because bus_target needs a pair to rule out pid
  # reuse before it fires a SIGUSR1.
  printf '%s\n%s\n' "$$" "$PPID" >"$f"
  BUS_SIDECAR_FILE=$f
}

# The stdio MCP server itself. Machine interface, not for a human to run by
# hand — its stdin/stdout are the JSON-RPC stream, so a terminal running it
# directly just sits there.
cmd_bus() {
  need jq
  # Not local: the EXIT trap runs after cmd_bus's frame is gone, so the path it
  # removes has to outlive the function.
  BUS_SIDECAR_FILE=""
  bus_cleanup() {
    [ -z "${BUS_SIDECAR_FILE:-}" ] || rm -f "$BUS_SIDECAR_FILE"
    return 0
  }
  # A signal trap must exit, not just clean up: bash runs the handler and then
  # resumes the interrupted `read`, so a bare cleanup would leave the server
  # answering requests with its marker gone — omp sees a healthy transport,
  # never reconnects, and the session silently falls back to the sweeper.
  trap 'bus_cleanup; exit 0' HUP INT TERM
  trap 'bus_cleanup' EXIT
  # The doorbell. That same resume-after-trap behaviour is what makes this one
  # process sufficient: verified on macOS bash 3.2.57, a USR1 arriving while
  # `read` is blocked runs the handler and restarts the read rather than
  # returning, so the loop below neither drops the frame it was waiting on nor
  # exits. A watcher child polling state for changes — what this replaces —
  # cost four `herdr agent list` calls a second in every pane to learn what the
  # writer already knew.
  trap 'bus_notify_wake' USR1
  bus_publish

  # This read deliberately has no timeout: a wake is a signal, so there is
  # nothing for a tick to notice, and polling here would only delay JSON-RPC
  # request handling.
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && bus_handle_frame "$line"
  done
  return 0
}

# ── Inventory and teardown ───────────────────────────────────────────────────

# Whitespace-separated handles for every registered worker, scoped to one repo
# key. An empty scope means every repo on the machine and is reachable only
# through an explicit --all-repos; every default path goes through
# scoped_key(). `true` at the end because a filtered-out or non-live final
# entry would otherwise leave the function non-zero and trip `set -e` at the
# caller's assignment.
known_workers() {
  local scope=${1-} d handle
  for d in "$FOREMAN_STATE"/*/; do
    [ -d "$d" ] || continue
    handle=$(basename "$d")
    [ -z "$scope" ] || [ "$(meta_get "$handle" REPO_KEY)" = "$scope" ] || continue
    printf '%s\n' "$handle"
  done
  true
}

live_workers() {
  local handle
  for handle in $(known_workers "${1-}"); do
    if agent_exists "$handle"; then printf '%s\n' "$handle"; fi
  done
  true
}

# The repo key a default-scoped command must run under. Failing closed is the
# whole point: outside a repo the key is empty, and an empty key would widen
# `join`, `ls` and `reap --all` back to every repo on the machine — the exact
# machine-global behaviour scoping exists to prevent.
scoped_key() {
  local key; key=$(repo_key)
  [ -n "$key" ] || die "not in a git repo, so '$1' has nothing to scope to
  $2"
  printf '%s' "$key"
}

cmd_ls() {
  require_herdr
  local scope=""
  if [ "${1:-}" != "--all-repos" ]; then
    scope=$(scoped_key "foreman ls" "run it from inside a repo, or pass --all-repos")
  fi
  local handle status q
  printf '%-20s %-9s %-2s %-28s %s\n' HANDLE STATUS Q BRANCH DIR
  for handle in $(known_workers "$scope"); do
    status=$(agent_field "$handle" agent_status)
    [ -n "$status" ] || status=gone
    # Unanswered, not undelivered: the column answers "who is waiting on me",
    # and a question the worker already pushed is still waiting.
    q=-
    if question_open "$handle"; then q='?'; fi
    printf '%-20s %-9s %-2s %-28s %s\n' "$handle" "$status" "$q" \
      "$(meta_get "$handle" BRANCH)" "$(meta_get "$handle" DIR)"
  done
}

cmd_reap() {
  require_herdr
  local force=0 all=0 all_repos=0 forget=0 handles="" scope
  # Not named `usage`: that is a function here, and shadowing it with a string
  # reads like a call site that would silently do nothing.
  local use="usage: foreman reap <handle>... | --all [--all-repos] [--force] [--forget]"
  while [ $# -gt 0 ]; do
    case $1 in
      --force) force=1; shift ;;
      --forget) forget=1; shift ;;
      --all) all=1; shift ;;
      --all-repos) all_repos=1; shift ;;
      -*) die "$use" ;;
      *) handles="$handles $1"; shift ;;
    esac
  done
  # Resolved once the whole line is parsed, not as each flag is seen: scoping
  # `--all` on sight made `foreman reap --all --all-repos` fail outside a repo by
  # telling the user to pass the flag they had already passed.
  if [ "$all_repos" = 1 ]; then
    handles="$handles $(known_workers)"
  elif [ "$all" = 1 ]; then
    scope=$(scoped_key "foreman reap --all" "pass --all-repos, or name the handles to reap")
    handles="$handles $(known_workers "$scope")"
  fi
  [ -n "${handles// /}" ] || die "$use"

  local handle
  # Validated up front, before anything is removed: the `rm -rf` below joins a
  # handle onto $FOREMAN_STATE, so one that is not a handle — `../..`, an
  # absolute path — would delete outside it. Every other caller derives its
  # handles from state or validates them at spawn; these came off the command
  # line. Checking the whole list first also keeps a bad third argument from
  # reaping the two good ones ahead of it.
  for handle in $handles; do
    valid_handle "$handle" || die "invalid handle '$handle'"
  done

  local failed=0
  for handle in $handles; do
    reap_one "$handle" "$force" "$forget" || failed=1
  done
  [ "$failed" = 0 ]
}

# The workspace the operator is actually looking at, independent of the pane
# this command happens to run from. `reap_one` needs it to undo a herdr-level
# side effect on `worktree remove` — see the comment there. Best-effort, not
# `h`: this is UX polish, not a correctness requirement, so a failure here
# (herdr momentarily unreachable, an older herdr without `workspace list`)
# degrades to "skip the restore" rather than aborting the whole reap. The
# trailing `|| true` is load-bearing under this file's `set -e -o pipefail`:
# without it, `restore_ws=$(focused_workspace_id)` at the call site would
# abort the entire `foreman reap` on exactly the failure this is meant to
# tolerate.
focused_workspace_id() {
  herdr workspace list 2>/dev/null \
    | jq -r '(.result.workspaces[]? | select(.focused == true) | .workspace_id) // empty' 2>/dev/null \
    || true
}

# Remove one worker: its workspace, then its record. Returns non-zero when the
# workspace could not be removed, and in that case the record is deliberately
# left behind — forgetting a worker whose worktree is still on disk is exactly
# how a worktree becomes invisible to every foreman command.
#
# `--forget` is the inverse, and the missing half of teardown: a worktree
# already removed by hand leaves a record `worktree remove` can never satisfy,
# so before this the worker sat in `foreman ls` as `gone` permanently.
reap_one() {
  local handle=$1 force=$2 forget=$3 missing_ok=${4:-0} ws out code
  ws=$(meta_get "$handle" WORKSPACE)
  if [ "$forget" = 1 ]; then
    note "foreman: forgot $handle ($(meta_get "$handle" BRANCH)); its worktree at $(meta_get "$handle" DIR) is untouched"
  elif [ -n "$ws" ]; then
    local -a args
    args=(worktree remove --workspace "$ws")
    [ "$force" = 1 ] && args+=(--force)
    # `worktree remove` focuses the removed worktree's parent workspace as an
    # unconditional herdr-level side effect (the parent is whichever workspace
    # `foreman spawn` ran from) — unlike `worktree create`, it has no --no-focus
    # flag to suppress that. `foreman_reap` runs from a background aside inside
    # the boss's own pane, so without this the operator gets yanked away
    # from whatever repo they were actually looking at every time a worker is
    # reaped. Capturing and restoring focus around the one call that moves it
    # undoes the side effect without herdr needing to add a flag it doesn't
    # have.
    local restore_ws; restore_ws=$(focused_workspace_id)
    # A worker with uncommitted work makes herdr refuse; that refusal is the
    # safety net, so it is reported and skipped rather than forced silently.
    if out=$(herdr "${args[@]}" 2>&1); then
      note "foreman: removed $handle ($(meta_get "$handle" BRANCH))"
      # `|| true`: if the operator was looking straight at the worktree that
      # was just removed, refocusing its now-gone id fails — harmlessly,
      # since herdr already picked something reasonable on its own then.
      [ -n "$restore_ws" ] && herdr workspace focus "$restore_ws" >/dev/null 2>&1 || true
    else
      code=$(printf '%s' "$out" | jq -r '.error.code // empty' 2>/dev/null || true)
      # `spawn --replace` is the one caller allowed to treat workspace_not_found
      # as success: it is replacing a dead worker, and "remove the recorded
      # workspace first" is already satisfied when somebody removed it by hand.
      # Ordinary `reap` still requires the explicit --forget, preserving the
      # rule that a failed removal never silently makes a worktree invisible.
      if [ "$missing_ok" = 1 ] && [ "$code" = workspace_not_found ]; then
        note "foreman: the old workspace for $handle is already gone; clearing its stale record"
      else
        note "foreman: could not remove $handle's worktree ($(meta_get "$handle" DIR))
  herdr said:             ${out:-no error payload}
  uncommitted changes?   foreman reap $handle --force
  already gone by hand?  foreman reap $handle --forget"
        return 1
      fi
    fi
  fi
  rm -rf "${FOREMAN_STATE:?}/$handle"
}

# The dashboard is a separate program rather than a cmd_* in here: it is also
# the plugin's popup pane entrypoint, which herdr launches directly, and it
# sources this file for its state helpers. Exec'ing it keeps one copy on disk
# and lets `foreman dashboard` and the palette action reach the same code.
cmd_dashboard() {
  local bin; bin="$(foreman_script_dir)/foreman-dashboard"
  [ -x "$bin" ] || die "foreman-dashboard is missing from $(foreman_script_dir)"
  exec "$bin" "$@"
}

# ── Entry point ──────────────────────────────────────────────────────────────

usage() {
  cat >&2 <<'EOF'
foreman — dispatch peer coding agents into herdr worktree workspaces

Boss
  foreman boss [name] [--steal]    claim the boss handle for this pane
  foreman spawn <branch> [opts]    create a worktree, start an agent, dispatch
  foreman send [--raw] <h> <text>  dispatch work, return immediately
  foreman ask <h> <text>           dispatch and block until the report is in
  foreman join [handle...]         re-read workers, or wait on named ones
                                 [--timeout <seconds>] bounds either wait
                                 [--once] one sweep tick; exit 3 = nothing to sweep
  foreman ls [--all-repos]         list workers and their states
  foreman dashboard [--all-repos]  inspect and operate the foreman interactively
  foreman read <handle> [-n N]     read a worker's terminal directly
  foreman reap <handle>...|--all   remove worktrees and forget workers
                                 [--all-repos] [--force] [--forget]
  foreman broadcast <text>         raw steering to every live worker in this repo
  foreman keys <handle> <key>...   send terminal keys (e.g. unblock an approval)

Worker
  foreman report [-f file|text]    deliver the report to the boss, and file it
  foreman reply <text>             deliver a question to the boss, and file it
  foreman whoami                   print this pane's handle

Both
  foreman doctor                   check prerequisites
  foreman version                  print the foreman version
  foreman roles                    list role -> skill mappings from foreman's config
  foreman init                     scaffold .foreman/config.yml for this repo
  foreman dm <handle> <text>       raw steering to any foreman member
  foreman pickup                   print this pane's next deliverable, if any
                                 exit 0 = printed, 3 = nothing pending, else error

Machine interface (spawned by omp; not for interactive use)
  foreman bus                      stdio MCP server that wakes omp on delivery

--raw sends text alone; without it foreman appends its protocol block, which is
right for a task and wrong for a one-line answer.
--forget drops foreman's record and leaves the worktree alone.
foreman broadcast and foreman dm are always raw, untracked steering: like --raw,
no protocol block and no dispatch counter bump.

`foreman spawn --help` lists spawn options.
EOF
  exit 2
}

main() {
  [ $# -gt 0 ] || usage
  local cmd=$1; shift
  case "$cmd" in
    boss)    cmd_boss "$@" ;;
    whoami)  cmd_whoami "$@" ;;
    spawn)   [ "${1:-}" = "--help" ] && usage_spawn; cmd_spawn "$@" ;;
    send)    cmd_send "$@" ;;
    ask)     cmd_ask "$@" ;;
    join)    cmd_join "$@" ;;
    read)    cmd_read "$@" ;;
    report)  cmd_report "$@" ;;
    reply)   cmd_reply "$@" ;;
    ls|list) cmd_ls "$@" ;;
    dashboard|dash) cmd_dashboard "$@" ;;
    reap)    cmd_reap "$@" ;;
    broadcast) cmd_broadcast "$@" ;;
    dm)      cmd_dm "$@" ;;
    pickup)  cmd_pickup "$@" ;;
    bus)     cmd_bus "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    roles)   cmd_roles "$@" ;;
    init)    cmd_init "$@" ;;
    version|--version|-V) cmd_version ;;
    -h|--help|help) usage ;;
    *) die "unknown command '$cmd' (try: foreman --help)" ;;
  esac
}

# Executed normally; sourced by the test suite, which wants the functions
# without running a command.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
