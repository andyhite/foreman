#!/usr/bin/env bash
# fleet dashboard — inspect and operate a fleet from one screen.
#
# `fleet ls` answers "who exists"; everything else about a wave — who is
# blocked on a question, whose report is fresh, what a worker's terminal is
# showing right now — costs a separate command and a handle you have to have
# memorised. This is that state in one place, with the operations attached to
# the row they act on.
#
# It is declared as a herdr plugin pane with `placement = "popup"`, so the
# ordinary way in is the command palette. It is also a normal program: run
# `fleet dashboard` in any pane and it behaves identically.
#
# Two facts about a popup drive the I/O in here, both measured rather than
# assumed:
#
#   - Only *stdin* is a tty. stdout and stderr are not, so `tput` reports its
#     80x24 fallback and anything that checks isatty turns its formatting off.
#     Every byte this script draws goes to /dev/tty and every dimension comes
#     from `stty size </dev/tty`.
#   - The process starts in the plugin root, not the workspace. The repo whose
#     workers we are meant to show arrives in $HERDR_PLUGIN_CONTEXT_JSON, the
#     same way `fleet-ls` gets it.
#
# Mechanism is not reimplemented here. Reads come from sourcing `fleet` for its
# state helpers; every mutation shells out to the `fleet` subcommand that owns
# it, so dispatch semantics have exactly one implementation.

set -euo pipefail

dash_script_dir() {
  local path=${BASH_SOURCE[0]} dir target
  while [ -L "$path" ]; do
    dir=$(cd -P "$(dirname "$path")" && pwd)
    target=$(readlink "$path")
    case "$target" in /*) path=$target ;; *) path="$dir/$target" ;; esac
  done
  cd -P "$(dirname "$path")" && pwd
}

DASH_DIR=$(dash_script_dir)
FLEET_BIN="$DASH_DIR/fleet"
[ -x "$FLEET_BIN" ] || {
  printf 'fleet-dashboard: no executable fleet beside %s\n' "$DASH_DIR" >&2
  exit 1
}

# Sourced, not executed: `fleet` guards its own entry point, so this brings in
# meta_get, known_workers, report_is_fresh, question_pending and the rest
# without running a command.
# shellcheck source=./fleet
. "$FLEET_BIN"

# How long the dashboard waits for a keystroke before redrawing. This is what
# keeps the list live while a wave runs, and it is also the whole polling cost:
# one `agent list` per tick. Rounded up to tenths of a second because the wait
# is enforced by the tty driver (`stty time`), which counts in them.
DASH_POLL_MS="${FLEET_DASHBOARD_POLL_MS:-2000}"
# Lines of a worker's terminal that `t` pulls.
DASH_TAIL_LINES="${FLEET_DASHBOARD_TAIL_LINES:-200}"

# ── Terminal ─────────────────────────────────────────────────────────────────

DASH_TTY=/dev/tty
DASH_ROWS=24
DASH_COLS=80
DASH_RAW=0
DASH_SCREEN=0

dash_measure() {
  local size
  size=$(stty size <"$DASH_TTY" 2>/dev/null) || size=""
  case "$size" in
    [0-9]*' '[0-9]*)
      DASH_ROWS=${size%% *}
      DASH_COLS=${size##* }
      ;;
  esac
  # herdr clamps a popup to a usable minimum; a hand-run dashboard in a sliver
  # of a split is not clamped by anything. Below this the layout stops meaning
  # anything, so draw a small frame rather than compute negative widths.
  [ "$DASH_ROWS" -ge 10 ] || DASH_ROWS=10
  [ "$DASH_COLS" -ge 40 ] || DASH_COLS=40
}

dash_out() { printf '%s' "$*" >"$DASH_TTY"; }

# Ordinary key reads use `min 0 time N`, so an idle read returns empty after
# one poll interval instead of pinning the loop or blocking the redraw.
dash_raw_on() {
  local tenths=$(( (DASH_POLL_MS + 99) / 100 ))
  [ "$tenths" -ge 1 ] || tenths=1
  [ "$tenths" -le 255 ] || tenths=255
  stty raw -echo min 0 time "$tenths" <"$DASH_TTY" 2>/dev/null || return 1
  DASH_RAW=1
}

dash_raw_off() {
  [ "$DASH_RAW" = 1 ] || return 0
  stty sane <"$DASH_TTY" 2>/dev/null || true
  DASH_RAW=0
}

dash_enter_screen() {
  dash_out $'\033[?1049h\033[?25l'
  DASH_SCREEN=1
  dash_raw_on || die "no usable terminal on $DASH_TTY"
}

# Restoring the terminal is not optional: a dashboard that exits in raw mode
# with the cursor hidden leaves the pane underneath unusable.
dash_leave_screen() {
  dash_raw_off
  [ "$DASH_SCREEN" = 1 ] || return 0
  DASH_SCREEN=0
  dash_out $'\033[?25h\033[?1049l'
}

trap 'dash_leave_screen' EXIT
trap 'exit 130' INT TERM

# One byte from the terminal as two hex digits, or empty when the driver's
# timeout expired with nothing to read.
#
# `dd` rather than `read -n 1`, which is what this used to be. bash's `read -n`
# reprograms the terminal to VMIN=1/VTIME=0 for the duration of the call and
# restores it afterwards, so it silently overrides the `stty time` every wait in
# here is built on. Two bugs came out of that, both of which look like separate
# features misbehaving: a lone Escape blocked until the *next* keystroke arrived
# and then swallowed it, so Escape never closed the dashboard; and the poll read
# never timed out, so the list only redrew when a key was pressed. `dd` issues a
# plain read(2) and gets exactly the driver's behaviour.
#
# Hex rather than the byte itself because command substitution strips a trailing
# newline: a byte that was read and no byte at all would otherwise both arrive
# here as the empty string.
dash_byte() {
  dd bs=1 count=1 <"$DASH_TTY" 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

dash_chr() {
  [ -n "$1" ] || return 0
  printf "\\$(printf '%03o' "$((16#$1))")"
}

# Split from dash_key so the sequences can be asserted without a terminal.
dash_decode_escape() {
  case "$1" in
    5b41) printf 'up' ;;
    5b42) printf 'down' ;;
    5b43) printf 'right' ;;
    5b44) printf 'left' ;;
    '')   printf 'esc' ;;
    *)    printf 'unknown' ;;
  esac
}

# One keystroke, named.
dash_key() {
  # LC_ALL=C for the same reason valid_handle needs it: the control-byte arm
  # below is a glob range, and a locale that interleaves case in its collation
  # order widens `[0-9a-f]` past the bytes it is meant to name.
  local LC_ALL=C
  local b rest
  b=$(dash_byte)
  case "$b" in
    '')    printf 'tick'; return 0 ;;
    1b)    ;;
    0d|0a) printf 'enter'; return 0 ;;
    # Every other control byte is dropped rather than turned into a keystroke.
    # A terminal hands out more of these than a keyboard does — a pty emits EOT
    # at setup, and a disconnected one emits it again — and mapping them onto
    # characters made those bytes act like whatever key shares their code.
    0[0-9a-f]|1[0-9a-f]|7f) printf 'none'; return 0 ;;
    *)     dash_chr "$b"; return 0 ;;
  esac
  # The rest of an escape sequence arrives in the same burst, so a tenth of a
  # second separates an arrow key from a bare Escape. bash 3.2 — the bash macOS
  # ships, and the oldest this plugin supports — rejects a fractional `read -t`,
  # which is why the sub-second wait is the driver's rather than the shell's.
  stty min 0 time 1 <"$DASH_TTY" 2>/dev/null || true
  rest=$(dash_byte)
  [ -z "$rest" ] || rest="$rest$(dash_byte)"
  dash_raw_on || true
  dash_decode_escape "$rest"
}

# ── Presentation ─────────────────────────────────────────────────────────────

if [ -n "${NO_COLOR:-}" ]; then
  C_RESET="" C_DIM="" C_BOLD="" C_REV="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE=""
else
  C_RESET=$'\033[0m' C_DIM=$'\033[2m' C_BOLD=$'\033[1m' C_REV=$'\033[7m'
  C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_BLUE=$'\033[34m'
fi

# Truncate to $2 display columns, with an ellipsis when it does not fit.
# ${#s} counts characters, so the ellipsis costs one column like everything
# else; the only field here that is not ASCII by construction is the path.
dash_fit() {
  local s=$1 w=$2
  [ "$w" -gt 0 ] || { printf ''; return 0; }
  if [ ${#s} -le "$w" ]; then printf '%s' "$s"; return 0; fi
  [ "$w" -gt 1 ] || { printf '%.1s' "$s"; return 0; }
  printf '%.*s…' "$((w - 1))" "$s"
}

# Pad to $2 display columns. printf's own `%-*s` pads to a byte count, so any
# field carrying the truncation ellipsis — or a path with a non-ASCII component
# — comes up two columns short and drags every column after it out of line.
dash_pad() {
  local n=$(( $2 - ${#1} ))
  [ "$n" -ge 0 ] || n=0
  printf '%s%*s' "$1" "$n" ''
}

# Both at once, which is what every column in the table wants.
dash_cell() { dash_pad "$(dash_fit "$1" "$2")" "$2"; }

# shellcheck disable=SC2088  # the tilde is display text here, not a path
dash_tilde() {
  case "$1" in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# A worker's headline glyph. Status comes from herdr; an unanswered question
# outranks it, because a worker waiting on you is the one thing in a wave that
# stops everything else from mattering.
dash_glyph() {
  local status=$1 question=$2
  if [ "$question" = 1 ]; then printf '?'; return 0; fi
  case "$status" in
    working) printf '>' ;;
    blocked) printf '!' ;;
    done)    printf '*' ;;
    idle)    printf 'o' ;;
    gone)    printf 'x' ;;
    *)       printf '.' ;;
  esac
}

dash_status_color() {
  case "$1" in
    working) printf '%s' "$C_BLUE" ;;
    blocked) printf '%s' "$C_RED" ;;
    done)    printf '%s' "$C_GREEN" ;;
    gone)    printf '%s' "$C_DIM" ;;
    *)       printf '' ;;
  esac
}

# ── Model ────────────────────────────────────────────────────────────────────

DASH_SCOPE_DIR=""   # the repository the dashboard is scoped to
DASH_ALL_REPOS=0    # 0 scoped, 1 asked for every repo, 2 forced by having no repo
DASH_SEL=0
DASH_COUNT=0
DASH_HANDLES=""     # newline-separated, index-aligned with DASH_SEL
DASH_STATUSES=""    # "<name><tab><status>", one `agent list` per refresh
DASH_MESSAGE=""
DASH_LOG=""
DASH_TAB=$'\t'

# Where the dashboard is looking. An explicit --cwd wins; inside a plugin pane
# the workspace herdr handed us wins over our own cwd, which is the plugin root
# and would otherwise scope every popup to this plugin's own checkout.
dash_scope_dir() {
  local explicit=$1 entrypoint=$2 context=$3 fallback=$4 cwd
  if [ -n "$explicit" ]; then printf '%s' "$explicit"; return 0; fi
  if [ -n "$entrypoint" ] && [ -n "$context" ]; then
    cwd=$(printf '%s' "$context" | jq -r '.workspace_cwd // empty' 2>/dev/null) || cwd=""
    if [ -n "$cwd" ] && [ -d "$cwd" ]; then printf '%s' "$cwd"; return 0; fi
  fi
  printf '%s' "$fallback"
}

dash_status_of() {
  local want=$1 name status
  while IFS="$DASH_TAB" read -r name status; do
    if [ "$name" = "$want" ]; then printf '%s' "$status"; return 0; fi
  done <<EOF
$DASH_STATUSES
EOF
  printf 'gone'
}

dash_handle_at() {
  local i=0 handle
  while IFS= read -r handle; do
    [ -n "$handle" ] || continue
    if [ "$i" = "$1" ]; then printf '%s' "$handle"; return 0; fi
    i=$((i + 1))
  done <<EOF
$DASH_HANDLES
EOF
  printf ''
}

dash_selected() { dash_handle_at "$DASH_SEL"; }

dash_refresh() {
  local agents scope="" handle
  agents=$(herdr agent list 2>/dev/null) || agents=""
  DASH_STATUSES=""
  if [ -n "$agents" ]; then
    DASH_STATUSES=$(printf '%s' "$agents" \
      | jq -r '.result.agents[]? | "\(.name)\t\(.agent_status)"' 2>/dev/null) || DASH_STATUSES=""
  fi
  if [ "$DASH_ALL_REPOS" = 0 ]; then
    scope=$(repo_key "$DASH_SCOPE_DIR")
    # Having nothing to scope to is fatal for `fleet ls`, which would silently
    # widen to the whole machine. Here the widening is visible in the header,
    # so the dashboard shows everything and says which mode it is in.
    if [ -z "$scope" ]; then DASH_ALL_REPOS=2; fi
  fi
  DASH_HANDLES=$(known_workers "$scope")
  DASH_COUNT=0
  while IFS= read -r handle; do
    [ -n "$handle" ] || continue
    DASH_COUNT=$((DASH_COUNT + 1))
  done <<EOF
$DASH_HANDLES
EOF
  if [ "$DASH_SEL" -ge "$DASH_COUNT" ]; then DASH_SEL=$((DASH_COUNT - 1)); fi
  if [ "$DASH_SEL" -lt 0 ]; then DASH_SEL=0; fi
}

# ── Frame ────────────────────────────────────────────────────────────────────
#
# A frame is built whole and written in one call. Drawing line by line makes
# the popup tear on every redraw, and a redraw happens every poll tick.
#
# The last line carries no newline. Writing $DASH_ROWS terminated lines scrolls
# the screen by one and turns the fixed frame into a flicker.

DASH_FRAME=""
dash_line() { DASH_FRAME="$DASH_FRAME$1"$'\033[K\r\n'; }
dash_line_last() { DASH_FRAME="$DASH_FRAME$1"$'\033[K'; }

dash_scope_label() {
  case "$DASH_ALL_REPOS" in
    0) basename "$DASH_SCOPE_DIR" ;;
    2) printf 'every repo (not in one)' ;;
    *) printf 'every repo' ;;
  esac
}

dash_header() {
  local plural="s" visible right pad
  [ "$DASH_COUNT" != 1 ] || plural=""
  visible=" fleet · $(dash_scope_label) · $DASH_COUNT worker$plural"
  right="? help  q quit "
  pad=$((DASH_COLS - ${#visible} - ${#right}))
  [ "$pad" -ge 1 ] || pad=1
  dash_line "${C_REV}${C_BOLD} fleet${C_RESET}${C_REV} · $(dash_scope_label) · $DASH_COUNT worker$plural$(printf '%*s' "$pad" '')${right}${C_RESET}"
}

# Column widths are derived, not fixed: a popup is a percentage of the
# terminal, so an 80-column frame and a 190-column one both have to read.
dash_columns() {
  DASH_W_HANDLE=20
  DASH_W_STATUS=8
  DASH_W_FLAGS=4
  local rest=$((DASH_COLS - 3 - DASH_W_HANDLE - DASH_W_STATUS - DASH_W_FLAGS - 5))
  [ "$rest" -ge 18 ] || rest=18
  DASH_W_BRANCH=$((rest * 2 / 5))
  [ "$DASH_W_BRANCH" -ge 8 ] || DASH_W_BRANCH=8
  DASH_W_DIR=$((rest - DASH_W_BRANCH))
  [ "$DASH_W_DIR" -ge 8 ] || DASH_W_DIR=8
}

# `<dispatches><report><join>` — where a worker sits in the send/report/collect
# cycle, which is the part `fleet ls` cannot show at all.
dash_flags() {
  local handle=$1 dispatched joined out
  dispatched=$(counter_read "$(dispatch_file "$handle")")
  joined=$(counter_read "$(joined_token_file "$handle")")
  out="${dispatched:-0}"
  if report_is_fresh "$handle"; then out="$out+"; else out="$out-"; fi
  if [ "$dispatched" = "$joined" ]; then out="$out."; else out="$out^"; fi
  printf '%s' "$out"
}

dash_row() {
  local handle=$1 selected=$2 status branch dir question=0 glyph line color
  status=$(dash_status_of "$handle")
  [ -n "$status" ] || status=gone
  branch=$(meta_get "$handle" BRANCH)
  dir=$(dash_tilde "$(meta_get "$handle" DIR)")
  if question_pending "$handle"; then question=1; fi
  glyph=$(dash_glyph "$status" "$question")
  color=$(dash_status_color "$status")
  [ "$question" = 0 ] || color=$C_YELLOW

  line=" $glyph $(dash_cell "$handle" "$DASH_W_HANDLE")"
  line="$line $(dash_cell "$status" "$DASH_W_STATUS")"
  line="$line $(dash_cell "$(dash_flags "$handle")" "$DASH_W_FLAGS")"
  line="$line $(dash_cell "$branch" "$DASH_W_BRANCH")"
  line="$line $(dash_fit "$dir" "$DASH_W_DIR")"
  line=$(dash_fit "$line" "$DASH_COLS")
  if [ "$selected" = 1 ]; then
    # Padded to the frame so the highlight reads as a bar rather than as a
    # ragged blot ending wherever the longest column happened to stop.
    printf '%s%s%s' "$C_REV" "$(dash_pad "$line" "$DASH_COLS")" "$C_RESET"
  else
    printf '%s%s%s' "$color" "$line" "$C_RESET"
  fi
}

# What the selected worker is currently saying: its unanswered question if it
# has one, else the report for its latest dispatch, else why there is neither.
dash_detail_lines() {
  local handle=$1 budget=$2 f
  if [ -z "$handle" ]; then
    printf 'no workers here — n spawns one, A widens the scope to every repo\n'
    return 0
  fi
  if question_pending "$handle"; then
    printf 'QUESTION from %s — a answers it\n' "$handle"
    f=$(question_file "$handle")
    if [ -s "$f" ]; then sed -n "1,${budget}p" "$f"; fi
    return 0
  fi
  f=$(report_file "$handle")
  if report_is_fresh "$handle"; then
    printf 'report for dispatch %s — r opens all of it\n' \
      "$(counter_read "$(dispatch_file "$handle")")"
    sed -n "1,${budget}p" "$f"
  elif [ -s "$f" ]; then
    printf 'no report for the current dispatch; the previous one begins:\n'
    sed -n "1,$((budget > 1 ? budget - 1 : 1))p" "$f"
  else
    printf '%s has filed no report — t reads its terminal\n' "$handle"
  fi
}

DASH_KEYMAP=' j/k move   enter focus   r report   t terminal   s send   S steer   a answer   n spawn   x reap   A scope'
# Tallest the detail band is allowed to get. Past a dozen or so lines the thing
# to reach for is `r`, which pages the whole report.
DASH_DETAIL_MAX=12

dash_draw() {
  local handle line i avail list_rows detail_rows first grow drawn
  dash_measure
  dash_columns

  # Fixed chrome: header, column heading, separator, status line. The detail
  # band is anchored to the bottom at a fixed height rather than sized to its
  # content: a band that grew and shrank with each selection would move the
  # separator on every keystroke.
  avail=$((DASH_ROWS - 4))
  detail_rows=$((avail / 3))
  [ "$detail_rows" -ge 3 ] || detail_rows=3
  [ "$detail_rows" -le "$DASH_DETAIL_MAX" ] || detail_rows=$DASH_DETAIL_MAX
  list_rows=$((avail - detail_rows))
  [ "$list_rows" -ge 1 ] || list_rows=1
  # A short list lends its unused rows to the detail band, up to that same cap.
  # Past the cap the slack is better left in the list, where it reads as room
  # for more workers rather than as an enormous empty box.
  if [ "$DASH_COUNT" -gt 0 ] && [ "$DASH_COUNT" -lt "$list_rows" ]; then
    grow=$((list_rows - DASH_COUNT))
    [ "$grow" -le $((DASH_DETAIL_MAX - detail_rows)) ] || grow=$((DASH_DETAIL_MAX - detail_rows))
    [ "$grow" -ge 0 ] || grow=0
    detail_rows=$((detail_rows + grow))
    list_rows=$((list_rows - grow))
  fi

  DASH_FRAME=$'\033[H'
  dash_header
  dash_line "${C_DIM}   $(dash_fit "$(printf '%-*s %-*s %-*s %-*s %s' \
    "$DASH_W_HANDLE" HANDLE "$DASH_W_STATUS" STATUS \
    "$DASH_W_FLAGS" DRJ "$DASH_W_BRANCH" BRANCH DIR)" $((DASH_COLS - 3)))${C_RESET}"

  # Scroll the window, not the selection: keep the cursor inside the visible
  # slice instead of clamping it to the first screenful.
  first=0
  if [ "$DASH_SEL" -ge "$list_rows" ]; then first=$((DASH_SEL - list_rows + 1)); fi

  i=0
  drawn=0
  while IFS= read -r handle; do
    [ -n "$handle" ] || continue
    if [ "$i" -ge "$first" ] && [ "$i" -lt $((first + list_rows)) ]; then
      if [ "$i" = "$DASH_SEL" ]; then
        dash_line "$(dash_row "$handle" 1)"
      else
        dash_line "$(dash_row "$handle" 0)"
      fi
      drawn=$((drawn + 1))
    fi
    i=$((i + 1))
  done <<EOF
$DASH_HANDLES
EOF
  if [ "$DASH_COUNT" = 0 ]; then
    dash_line "   ${C_DIM}(no workers)${C_RESET}"
    drawn=1
  fi
  # The band keeps its height whatever it holds. A frame that shrank with the
  # worker count would move the separator, the detail and the keymap up the
  # screen every time a worker was spawned or reaped.
  while [ "$drawn" -lt "$list_rows" ]; do dash_line ""; drawn=$((drawn + 1)); done

  dash_line "${C_DIM}$(printf '%*s' "$DASH_COLS" '' | tr ' ' '-')${C_RESET}"

  handle=$(dash_selected)
  i=0
  while IFS= read -r line; do
    [ "$i" -lt "$detail_rows" ] || break
    dash_line "  $(dash_fit "$line" $((DASH_COLS - 2)))"
    i=$((i + 1))
  done <<EOF
$(dash_detail_lines "$handle" "$detail_rows")
EOF
  while [ "$i" -lt "$detail_rows" ]; do dash_line ""; i=$((i + 1)); done

  if [ -n "$DASH_MESSAGE" ]; then
    dash_line_last "${C_YELLOW}$(dash_fit " $DASH_MESSAGE" "$DASH_COLS")${C_RESET}"
  else
    dash_line_last "${C_DIM}$(dash_fit "$DASH_KEYMAP" "$DASH_COLS")${C_RESET}"
  fi

  # Anything below the frame belongs to a previous, taller draw.
  DASH_FRAME="$DASH_FRAME"$'\033[J'
  dash_out "$DASH_FRAME"
}

# ── Viewers ──────────────────────────────────────────────────────────────────

# A scrollable full-screen page: reports, terminal dumps, the operation log,
# the help. Anything longer than the detail strip goes through here.
dash_view() {
  local title=$1 body=$2 top=0 total=0 key line i page shown
  while IFS= read -r line; do total=$((total + 1)); done <<EOF
$body
EOF
  while :; do
    dash_measure
    page=$((DASH_ROWS - 2))
    [ "$page" -ge 1 ] || page=1
    if [ "$top" -gt $((total - page)) ]; then top=$((total - page)); fi
    [ "$top" -ge 0 ] || top=0

    DASH_FRAME=$'\033[H'
    dash_line "${C_REV} $(dash_cell "$title" $((DASH_COLS - 1)))${C_RESET}"
    i=0
    while IFS= read -r line; do
      if [ "$i" -ge "$top" ] && [ "$i" -lt $((top + page)) ]; then
        dash_line " $(dash_fit "$line" $((DASH_COLS - 1)))"
      fi
      i=$((i + 1))
    done <<EOF
$body
EOF
    shown=$((total - top))
    [ "$shown" -le "$page" ] || shown=$page
    [ "$shown" -ge 0 ] || shown=0
    i=$shown
    while [ "$i" -lt "$page" ]; do dash_line ""; i=$((i + 1)); done
    dash_line_last "${C_DIM}$(dash_fit " j/k scroll   space page   g/G ends   q back   [$((top + 1))-$((top + shown)) of $total]" "$DASH_COLS")${C_RESET}"
    DASH_FRAME="$DASH_FRAME"$'\033[J'
    dash_out "$DASH_FRAME"

    key=$(dash_key)
    case "$key" in
      j|down) top=$((top + 1)) ;;
      k|up)   top=$((top - 1)) ;;
      ' ')    top=$((top + page)) ;;
      b)      top=$((top - page)) ;;
      g)      top=0 ;;
      G)      top=$total ;;
      q|esc|enter) return 0 ;;
    esac
  done
}

# ── Input ────────────────────────────────────────────────────────────────────

# One line of text, in cooked mode so the terminal's own line discipline
# supplies backspace and ^U. Returns non-zero on an empty line, which is how
# every prompt here is cancelled.
dash_prompt() {
  local label=$1 answer
  dash_raw_off
  dash_out "$(printf '\033[%d;1H\033[K\033[?25h' "$DASH_ROWS")${C_BOLD}${label}${C_RESET} "
  IFS= read -r answer <"$DASH_TTY" || answer=""
  dash_out $'\033[?25l'
  dash_raw_on || true
  [ -n "$answer" ] || return 1
  printf '%s' "$answer"
}

dash_confirm() {
  local key
  DASH_MESSAGE="$1 [y/N]"
  dash_draw
  key=$(dash_key)
  DASH_MESSAGE=""
  [ "$key" = y ] || [ "$key" = Y ]
}

# ── Operations ───────────────────────────────────────────────────────────────
#
# Every mutation is `fleet <subcommand>` run as a child process. Calling the
# sourced cmd_* functions directly would be cheaper and wrong: they end in
# `die` on any error, which from inside the loop takes the dashboard — and the
# terminal it is holding in raw mode — down with them.

dash_log_init() {
  local dir="$FLEET_STATE/.dashboard"
  mkdir -p "$dir" 2>/dev/null || true
  DASH_LOG="$dir/operations.log"
}

dash_log_head() { printf '\n=== %s — %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$DASH_LOG"; }

# Short operations run in the foreground: the user is waiting on the answer,
# and watching it happen is the point of having confirmed it.
dash_run() {
  local title=$1; shift
  local out rc=0
  DASH_MESSAGE="$title…"
  dash_draw
  dash_log_head "$title"
  out=$("$@" 2>&1) || rc=$?
  printf '%s\n' "$out" >>"$DASH_LOG"
  if [ "$rc" = 0 ]; then
    DASH_MESSAGE="$title — ok"
    return 0
  fi
  DASH_MESSAGE="$title — failed; l shows the log"
  dash_view "$title — exit $rc" "$out"
  return 1
}

# `fleet spawn` blocks for as long as a coding agent takes to boot, which in a
# session-modal popup is a frozen screen for a minute or more. It runs detached
# instead, and the worker appears in the list the moment herdr names it — which
# is the dashboard's whole job.
dash_run_detached() {
  local title=$1; shift
  dash_log_head "$title (background)"
  ( "$@" >>"$DASH_LOG" 2>&1 & ) >/dev/null 2>&1
  DASH_MESSAGE="$title — running in the background; l shows the log"
}

dash_op_focus() {
  local handle=$1
  [ -n "$handle" ] || return 0
  if [ "$(dash_status_of "$handle")" = gone ]; then
    DASH_MESSAGE="$handle has no live agent to focus; x reaps its record"
    return 0
  fi
  # Focus has to outlive this process. A popup is session-modal and closes when
  # its command exits, so a focus issued while it is still up lands underneath
  # the modal; from a detached child a beat later it lands on a session that
  # has already dropped it.
  ( sleep 0.2; herdr agent focus "$handle" >/dev/null 2>&1 & ) >/dev/null 2>&1
  DASH_QUIT=1
}

dash_op_report() {
  local handle=$1 f
  [ -n "$handle" ] || return 0
  f=$(report_file "$handle")
  if [ -s "$f" ]; then
    dash_view "$handle — report.md" "$(sed -n '1,4000p' "$f")"
  else
    DASH_MESSAGE="$handle has filed no report"
  fi
}

dash_op_terminal() {
  local handle=$1 out
  [ -n "$handle" ] || return 0
  DASH_MESSAGE="reading $handle's terminal…"
  dash_draw
  out=$("$FLEET_BIN" read "$handle" -n "$DASH_TAIL_LINES" 2>&1) || true
  DASH_MESSAGE=""
  dash_view "$handle — last $DASH_TAIL_LINES lines" "$out"
}

dash_op_send() {
  local handle=$1 raw=$2 text label
  [ -n "$handle" ] || return 0
  if [ "$raw" = 1 ]; then label="steer $handle:"; else label="task for $handle:"; fi
  if ! text=$(dash_prompt "$label"); then
    DASH_MESSAGE="cancelled"
    return 0
  fi
  if [ "$raw" = 1 ]; then
    dash_run "steer $handle" "$FLEET_BIN" send --raw "$handle" "$text" || true
  else
    dash_run "dispatch to $handle" "$FLEET_BIN" send "$handle" "$text" || true
  fi
}

# Answering is a raw send plus the acknowledgement `fleet join` would have
# written. Without the second half the question stays pending forever, and the
# next join returns early on a question that has already been answered.
dash_op_answer() {
  local handle=$1 text seq seen
  [ -n "$handle" ] || return 0
  if ! question_pending "$handle"; then
    DASH_MESSAGE="$handle is not waiting on an answer"
    return 0
  fi
  if ! text=$(dash_prompt "answer $handle:"); then
    DASH_MESSAGE="cancelled"
    return 0
  fi
  dash_run "answer $handle" "$FLEET_BIN" send --raw "$handle" "$text" || return 0
  seq=$(question_seq_file "$handle"); seen=$(question_seen_file "$handle")
  if [ -f "$seq" ]; then cp "$seq" "$seen"; else : >"$seen"; fi
}

dash_op_spawn() {
  local branch task root
  # `fleet spawn --repo` wants the repository, and the scope directory may be
  # any subdirectory of one.
  root=$(cd "$DASH_SCOPE_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || root=""
  if [ -z "$root" ]; then
    DASH_MESSAGE="$(dash_tilde "$DASH_SCOPE_DIR") is not in a git repo, so there is nothing to branch from"
    return 0
  fi
  if ! branch=$(dash_prompt "spawn branch:"); then
    DASH_MESSAGE="cancelled"
    return 0
  fi
  task=$(dash_prompt "task (empty to spawn without dispatching):") || task=""
  if [ -n "$task" ]; then
    dash_run_detached "spawn $branch" "$FLEET_BIN" spawn "$branch" --repo "$root" --task "$task"
  else
    dash_run_detached "spawn $branch" "$FLEET_BIN" spawn "$branch" --repo "$root" --no-dispatch
  fi
}

dash_op_reap() {
  local handle=$1 force=$2
  [ -n "$handle" ] || return 0
  if [ "$force" = 1 ]; then
    if ! dash_confirm "reap $handle and DISCARD its uncommitted work?"; then
      DASH_MESSAGE="cancelled"; return 0
    fi
    dash_run "reap $handle --force" "$FLEET_BIN" reap "$handle" --force || return 0
  else
    if ! dash_confirm "reap $handle and remove its worktree?"; then
      DASH_MESSAGE="cancelled"; return 0
    fi
    dash_run "reap $handle" "$FLEET_BIN" reap "$handle" || return 0
  fi
  if [ "$DASH_SEL" -gt 0 ]; then DASH_SEL=$((DASH_SEL - 1)); fi
}

DASH_HELP='fleet dashboard

  Navigation
    j / down        next worker
    k / up          previous worker
    g / G           first / last worker
    A               toggle between this repo and every repo on the machine
    R               refresh now (the list also refreshes on its own)
    q / esc         quit

  Inspect
    r               the full report the worker filed
    t               the last lines of the worker terminal
    l               this dashboard operation log
    ?               this help

  Operate
    enter           focus the worker agent, and close the dashboard
    s               dispatch a task           (fleet send)
    S               steer the current turn    (fleet send --raw)
    a               answer a pending question, and clear it
    n               spawn a new worker        (fleet spawn, in the background)
    x               reap the worker           (fleet reap)
    X               reap and discard uncommitted work   (fleet reap --force)

  Row flags: D R J
    D   the dispatch counter: how many tasks this worker has been given
    R   + when a report answering the current dispatch is on disk, - when not
    J   ^ when that dispatch has not been collected by a join yet, . when it has

  Glyphs
    >   working        !   blocked            *   done
    o   idle           x   no live agent      ?   waiting on an answer'

# The keymap as data, so the bindings can be asserted without a terminal.
dash_action_for_key() {
  case "$1" in
    j|down)      printf 'next' ;;
    k|up)        printf 'prev' ;;
    g)           printf 'first' ;;
    G)           printf 'last' ;;
    enter|right) printf 'focus' ;;
    r)           printf 'report' ;;
    t)           printf 'terminal' ;;
    l)           printf 'log' ;;
    s)           printf 'send' ;;
    S)           printf 'steer' ;;
    a)           printf 'answer' ;;
    n)           printf 'spawn' ;;
    x)           printf 'reap' ;;
    X)           printf 'reap-force' ;;
    A)           printf 'scope' ;;
    R)           printf 'refresh' ;;
    '?')         printf 'help' ;;
    q|esc)       printf 'quit' ;;
    tick)        printf 'tick' ;;
    *)           printf 'none' ;;
  esac
}

# ── Loop ─────────────────────────────────────────────────────────────────────

DASH_QUIT=0

dash_loop() {
  local key action handle body
  dash_refresh
  while [ "$DASH_QUIT" = 0 ]; do
    dash_draw
    key=$(dash_key)
    action=$(dash_action_for_key "$key")
    # Any real keystroke clears the last operation's status line; a poll tick
    # leaves it, so a result stays readable until the user moves on.
    [ "$action" = tick ] || DASH_MESSAGE=""
    handle=$(dash_selected)
    case "$action" in
      next)  if [ $((DASH_SEL + 1)) -lt "$DASH_COUNT" ]; then DASH_SEL=$((DASH_SEL + 1)); fi ;;
      prev)  if [ "$DASH_SEL" -gt 0 ]; then DASH_SEL=$((DASH_SEL - 1)); fi ;;
      first) DASH_SEL=0 ;;
      last)  if [ "$DASH_COUNT" -gt 0 ]; then DASH_SEL=$((DASH_COUNT - 1)); fi ;;
      scope)
        if [ "$DASH_ALL_REPOS" = 0 ]; then DASH_ALL_REPOS=1; else DASH_ALL_REPOS=0; fi
        DASH_SEL=0
        ;;
      focus)      dash_op_focus "$handle" ;;
      report)     dash_op_report "$handle" ;;
      terminal)   dash_op_terminal "$handle" ;;
      log)
        if [ -s "$DASH_LOG" ]; then body=$(sed -n '1,4000p' "$DASH_LOG"); else body='nothing yet'; fi
        dash_view "operation log — $(dash_tilde "$DASH_LOG")" "$body"
        ;;
      send)       dash_op_send "$handle" 0 ;;
      steer)      dash_op_send "$handle" 1 ;;
      answer)     dash_op_answer "$handle" ;;
      spawn)      dash_op_spawn ;;
      reap)       dash_op_reap "$handle" 0 ;;
      reap-force) dash_op_reap "$handle" 1 ;;
      help)       dash_view "help" "$DASH_HELP" ;;
      quit)       DASH_QUIT=1 ;;
    esac
    dash_refresh
  done
}

dash_usage() {
  cat >&2 <<'EOF'
usage: fleet dashboard [--cwd <dir>] [--all-repos]

An interactive view of this repository's fleet, with the operations attached to
the worker they act on. Press ? inside it for the keymap.
EOF
  exit 2
}

dash_main() {
  local explicit=""
  while [ $# -gt 0 ]; do
    case $1 in
      --cwd) explicit=${2:?--cwd needs a directory}; shift 2 ;;
      --all-repos) DASH_ALL_REPOS=1; shift ;;
      -h|--help) dash_usage ;;
      *) note "fleet-dashboard: unknown option '$1'"; dash_usage ;;
    esac
  done
  require_herdr
  [ -r "$DASH_TTY" ] || die "no controlling terminal; run the dashboard in a pane"

  DASH_SCOPE_DIR=$(dash_scope_dir "$explicit" "${HERDR_PLUGIN_ENTRYPOINT_ID:-}" \
    "${HERDR_PLUGIN_CONTEXT_JSON:-}" "$PWD")
  [ -d "$DASH_SCOPE_DIR" ] || die "not a directory: $DASH_SCOPE_DIR"
  dash_log_init
  dash_enter_screen
  dash_loop
}

# Executed normally; sourced by the test suite, which wants the functions
# without taking over the terminal.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then dash_main "$@"; fi
