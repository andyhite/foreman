{
  "compilerOptions": {
    // Type-check only — this repo has no build step; omp's Bun runtime
    // loads extension/index.ts directly. noEmit keeps CI from producing
    // artifacts nobody consumes.
    "noEmit": true,
    "strict": true,
    // No @oh-my-pi/pi-coding-agent or @types/bun package exists here (the
    // extension is a zero-dependency plugin, see extension/index.ts:6-15) —
    // skipLibCheck and an empty "types" keep the gate from requiring any
    // ambient package to be installed.
    "skipLibCheck": true,
    "types": [],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["extension/**/*.ts"],
  // extension/index.test.ts runs under `bun test`, which transpiles TS
  // without a full typecheck — it exercises real `bun:test`/`node:fs`
  // APIs this repo's zero-dependency ambient d.ts deliberately doesn't
  // model (see extension/pi-coding-agent.d.ts), so folding it into this
  // gate would require installing @types/bun/@types/node, which would in
  // turn collide with that ambient d.ts's own hand-written node:fs/Bun
  // augmentations for the production file.
  "exclude": ["extension/**/*.test.ts"]
}
