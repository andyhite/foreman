node_modules/
dist/
dist-types/

# `dist/` above is the CLI's bundle alone. The omp plugin has no build step:
# its `omp.extensions` entry names `src/extension.ts` and omp loads the
# TypeScript directly, so there is no artifact to track, stale, or forget to
# rebuild.
*.tsbuildinfo
.DS_Store

# Per-repo omp plugin activation state, written by `foreman init`: a
# node_modules symlink to `~/.foreman/plugin` (itself a symlink into this
# machine's foreman checkout) plus omp's enable/version lock. Machine-local,
# like node_modules/ above — the repo's binding to Foreman lives in
# ~/.foreman/config.json's `repos` table, not here.
.omp/plugins/

# bun.lock is committed: CI installs with --frozen-lockfile.
bun.lockb
