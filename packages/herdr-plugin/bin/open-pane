#!/bin/sh
# Opens one Foreman pane entrypoint.
#
# Actions exist because the command palette and `[[keys.command]]` address
# actions, never pane entrypoints — an action is the only way to reach a pane
# from a keybinding. Actions take no arguments, so each `[[actions]]` entry
# passes its entrypoint id here as a fixed argv element.
#
# Placement, width, and height come from the matching `[[panes]]` entry in
# herdr-plugin.toml; this script deliberately overrides none of them.
set -eu

entrypoint="${1:?usage: open-pane <entrypoint-id>}"

# Verified against herdr 0.8.2. Both variables are injected into every plugin
# command, so neither the binary location nor the plugin id is duplicated here.
herdr_bin="${HERDR_BIN_PATH:-herdr}"
plugin_id="${HERDR_PLUGIN_ID:-andyhite.foreman}"

# `--cwd` is load-bearing. A pane inherits the *caller's* working directory, not
# the plugin root, so the manifest's relative `dist/board.js` would not resolve
# and the pane would exit silently with an empty viewport. Actions themselves do
# run in the plugin root, hence the `$PWD` fallback.
plugin_root="${HERDR_PLUGIN_ROOT:-$PWD}"

exec "$herdr_bin" plugin pane open \
	--plugin "$plugin_id" \
	--entrypoint "$entrypoint" \
	--cwd "$plugin_root"
