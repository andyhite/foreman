{
  "name": "@foreman/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "foreman setup — installs the config file and the omp/herdr plugins",
  "bin": {
    "foreman": "./dist/main.js"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target bun --format esm",
    "start": "bun run ./src/main.ts"
  },
  "dependencies": {
    "@foreman/core": "workspace:*",
    "@foreman/loop": "workspace:*"
  }
}
