{
  "name": "foreman",
  "private": true,
  "version": "0.1.0",
  "description": "An omp-native plugin that runs a single-operator agile SDLC over Linear",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "schemas": "bun run packages/core/scripts/emit-schemas.ts",
    "contract": "bun run packages/omp-plugin/scripts/check-contract.ts",
    "check": "bun run typecheck && bun run test && bun run contract"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
